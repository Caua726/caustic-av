// =======================================================
// caustic-av/audio/mp3/mp3_tables_data.cst
// Blob data for audio/mp3/mp3_tables.cst.
//
// Every value below is the public documentation's, not a decoder's: the
// bitrate and sample-rate tables come from Tables 8 and 9, the
// scalefactor-band widths from Tables 42-59, pretab from Table 23, the
// alias coefficients from Table 60, the polyphase synthesis window from the
// D[0..511] table, and the Huffman codewords, lengths and linbits from
// Tables 24-41 of the Layer III bitstream description in
// .work/docs/mp3_bitstream.txt.
//
// Blob format:
//   * integer blobs are comma-separated decimal, no whitespace, NUL
//     terminated by the string literal;
//   * each Huffman entry is four integers x,y,hlen,hcod, repeated in
//     x-major, y-minor order. hcod is the binary codeword read as an
//     integer. Table 0 has one dummy entry; tables 4 and 14 have no
//     codewords at all. Tables 16-23 share MP3_HUFF_16_23 and tables
//     24-31 share MP3_HUFF_24_31.
//
// The scalefactor-band blobs store 22 long bands and 13 short bands per
// sampling-rate row, in the order 44.1, 48, 32, 22.05, 24, 16, 11.025, 12,
// 8 kHz. The published tables list the bands that carry scalefactors; the
// last entry of each row is the remaining lines to 576 (long) or 192
// (short), which is the part above the highest scalefactor band.
//
// PENDING: the analytic IMDCT windows and DCT twiddles are not printed
// tables, so they are empty here. mp3_window_tables_ready() reports
// MP3_WINDOW_TABLES_GENERATED, which is 0 now. The parser does not need
// them; stage 8b supplies them and must not synthesise until it is 1.
// =======================================================

// 0 until the stage 8b writer has written MP3_WINDOW_* below.
let is i64 as MP3_WINDOW_TABLES_GENERATED with imut = 0;

// PENDING: 36 long-block (normal, block_type 0) IMDCT window values.
let is *u8 as MP3_WINDOW_LONG with imut = "";
// PENDING: 36 start-block (block_type 1) window values.
let is *u8 as MP3_WINDOW_START with imut = "";
// PENDING: 36 stop-block (block_type 3) window values.
let is *u8 as MP3_WINDOW_STOP with imut = "";
// PENDING: 12 short-block (block_type 2) window values.
let is *u8 as MP3_WINDOW_SHORT with imut = "";
// PENDING: DCT/IMDCT twiddles, count fixed by stage 8b's transform.
let is *u8 as MP3_DCT_TWIDDLE with imut = "";

let is *u8 as MP3_BITRATE_MPEG1 with imut = "0,32,40,48,56,64,80,96,112,128,160,192,224,256,320,0";

