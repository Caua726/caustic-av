// =======================================================
// tests/test_matroska.cst
// Matroska/WebM demux checks against committed vectors and an in-memory file.
//
// The vectors are generated with ffmpeg (n9.0.2) and committed under
// tests/vectors/small/. The exact commands are below, so they can be
// regenerated byte for byte (both runs of each produced the same SHA-256):
//
//   ffmpeg -y -hide_banner -loglevel error \
//     -f lavfi -i "testsrc2=size=64x48:rate=10:duration=0.2" \
//     -frames:v 2 -c:v libvpx-vp9 -pix_fmt yuv420p -b:v 20k -crf 40 \
//     -g 1000 -keyint_min 1000 -lag-in-frames 0 -auto-alt-ref 0 \
//     -threads 1 -row-mt 0 -fflags +bitexact -flags:v +bitexact \
//     -f webm tests/vectors/small/vp9_2f.webm
//     sha256 f58eb693aa214760f9629a67c1d4a2aa378693e5e7224f62c6096fa8ef429f3e
//
//   ffmpeg -y -hide_banner -loglevel error \
//     -f lavfi -i "sine=frequency=440:sample_rate=48000:duration=0.2" \
//     -ac 2 -c:a libopus -b:a 48k -vbr off -application audio \
//     -frame_duration 20 -write_crc32 0 -fflags +bitexact \
//     -flags:a +bitexact -f webm tests/vectors/small/opus_stereo.webm
//     sha256 47eed1e2b9d3cc74fb5eb8e5c251b7ab831290c937136d5a1503b667bd683f2b
//
//   ffmpeg -y -hide_banner -loglevel error \
//     -f lavfi -i "testsrc2=size=64x48:rate=10:duration=0.1" \
//     -frames:v 1 -c:v libvpx-vp9 -pix_fmt yuv420p -b:v 20k -crf 40 \
//     -g 1000 -keyint_min 1000 -lag-in-frames 0 -auto-alt-ref 0 \
//     -threads 1 -row-mt 0 -fflags +bitexact -flags:v +bitexact \
//     -write_crc32 1 -f matroska tests/vectors/small/vp9_crc32.mkv
//     sha256 f2272ecfb31acb1b455f63e90c1fee74889a8c34d57c2f7751f69cf75d782170
//
// The third vector exists because the WebM muxer never writes CRC-32
// elements even with -write_crc32 1; only the Matroska muxer does. Its Info
// child carries one, so the skip path is exercised by a real ffmpeg file.
//
// ── Expected values, from ffprobe (n9.0.2) ──────────────────────────
//
// vp9_2f.webm:
//   $ ffprobe -v error -show_entries \
//       stream=codec_name,codec_type,width,height,extradata_size \
//       -show_entries format=duration -of default=noprint_wrappers=0 \
//       tests/vectors/small/vp9_2f.webm
//   [STREAM]
//   codec_name=vp9
//   codec_type=video
//   width=64
//   height=48
//   [/STREAM]
//   [FORMAT]
//   duration=0.200000
//   [/FORMAT]
//
//   $ ffprobe -v error -show_entries \
//       packet=stream_index,pts_time,dts_time,duration_time,size,flags \
//       -of csv=p=0 tests/vectors/small/vp9_2f.webm
//   0,0.000000,0.000000,0.100000,1192,K__
//   0,0.100000,0.100000,0.100000,38,___
//
//   Track: CodecID V_VP9 (ffprobe calls it vp9), type video, 64x48,
//   DefaultDuration 100 ms. Two packets, sizes 1192 and 38, pts 0 and
//   100,000,000 ns, keyframe then inter.
//
// opus_stereo.webm:
//   $ ffprobe -v error -show_entries \
//       stream=codec_name,codec_type,sample_rate,channels,initial_padding,extradata_size \
//       -of default=noprint_wrappers=0 tests/vectors/small/opus_stereo.webm
//   [STREAM]
//   codec_name=opus
//   codec_type=audio
//   sample_rate=48000
//   channels=2
//   initial_padding=312
//   extradata_size=19
//   [/STREAM]
//
//   $ ffprobe -v error -show_entries \
//       packet=pts_time,duration_time,size,flags -of csv=p=0 \
//       tests/vectors/small/opus_stereo.webm
//   -0.007000,0.020000,120,K__,
//   0.014000,0.020000,120,K__
//   0.034000,0.020000,120,K__
//   0.054000,0.020000,120,K__
//   0.074000,0.020000,120,K__
//   0.094000,0.020000,120,K__
//   0.114000,0.020000,120,K__
//   0.134000,0.020000,120,K__
//   0.154000,0.020000,120,K__
//   0.174000,0.020000,120,K__
//   0.194000,0.007000,120,K__,
//
//   ffprobe subtracts the track's 6.5 ms CodecDelay (initial_padding 312
//   samples at 48 kHz) and quantises to its 1 ms timebase, so its ticks are
//   exactly 7 less than the container's (0 -> -7, 21 -> 14, ...). The
//   container values asserted below are therefore ffprobe_tick + 7 ms:
//   0, 21, 41, ..., 201 ms. The 0.007 s last duration is the BlockDuration
//   of the final BlockGroup.
//
//   $ ffprobe -v error -show_packets -select_streams a:0 \
//       -show_entries packet=pts_time,duration,side_data_list -of json \
//       tests/vectors/small/opus_stereo.webm     (last packet)
//   {
//       "pts_time": "0.194000",
//       "duration": 7,
//       "side_data_list": [
//           {
//               "side_data_type": "Skip Samples",
//               "skip_samples": 0,
//               "discard_padding": 648,
//               "skip_reason": 0,
//               "discard_reason": 0
//           }
//       ]
//   }
//   648 samples / 48000 = 13,500,000 ns of DiscardPadding.
//
//   CodecPrivate (19 bytes):
//   $ ffprobe -v error -show_streams -show_data -select_streams a:0 \
//       tests/vectors/small/opus_stereo.webm | grep -A2 '^extradata='
//   extradata=
//   00000000: 4f70 7573 4865 6164 0102 3801 80bb 0000  OpusHead..8.....
//   00000010: 0000 00                                  ...
//   OpusHead, version 1, channels 2, pre-skip 312, input rate 48000,
//   gain 0, mapping family 0.
//
//   Values ffprobe does not print are read from their Matroska elements;
//   ffprobe's codec_name/codec_type are those elements decoded.
//   $ xxd -g1 -s 0x118 -l 48 tests/vectors/small/opus_stereo.webm
//   00000118: 83 75 6e 64 88 81 00 86 86 41 5f 4f 50 55 53 56  .und.....A_OPUSV
//   00000128: aa 83 63 2e a0 56 bb 84 04 c4 b4 00 83 81 02 23  ..c..V.........#
//   00000138: e3 83 84 01 31 2d 00 e1 91 9f 81 02 b5 88 40 e7  ....1-........@.
//   CodecID 0x86 = "A_OPUS"; CodecDelay 0x56AA = 0x632EA0 = 6,500,000 ns
//   (the OpusHead pre-skip, 312 samples at 48 kHz); SeekPreRoll 0x56BB =
//   0x04C4B400 = 80,000,000 ns; DefaultDuration 0x23E383 = 0x01312D00 =
//   20,000,000 ns; SamplingFrequency 0xB5 = 48000.0; Channels 0x9F = 2.
//
//   $ xxd -g1 -s 0x118 -l 48 tests/vectors/small/vp9_2f.webm
//   00000118: 83 75 6e 64 88 81 00 86 85 56 5f 56 50 39 83 81  .und.....V_VP9..
//   00000128: 01 23 e3 83 84 05 f5 e1 00 e0 90 b0 81 40 ba 81  .#...........@..
//   00000138: 30 9a 81 02 55 b0 84 55 b9 81 01 55 ee 81 00 ec  0...U..U...U....
//   CodecID 0x86 = "V_VP9"; TrackType 0x83 = 1 (video); PixelWidth 0xB0 =
//   64; PixelHeight 0xBA = 48; DefaultDuration 0x23E383 = 0x05F5E100 =
//   100,000,000 ns, matching ffprobe's 0.100 s packet duration.
//
// vp9_crc32.mkv:
//   $ ffprobe -v error -show_entries stream=codec_name,width,height \
//       -of default=noprint_wrappers=0 tests/vectors/small/vp9_crc32.mkv
//   [STREAM]
//   codec_name=vp9
//   width=64
//   height=48
//   [/STREAM]
//   $ ffprobe -v error -show_entries packet=pts_time,size,flags \
//       -of default=noprint_wrappers=0 tests/vectors/small/vp9_crc32.mkv
//   [PACKET]
//   pts_time=0.000000
//   size=1192
//   flags=K__
//   [/PACKET]
//
//   Its Info element starts with the Level-1 CRC-32:
//   $ xxd -g1 -s 0xd0 -l 32 tests/vectors/small/vp9_crc32.mkv
//   000000d0: 00 00 00 00 00 15 49 a9 66 a6 bf 84 49 b6 2f f2  ......I.f...I./.
//   000000e0: 2a d7 b1 83 0f 42 40 4d 80 84 4c 61 76 66 57 41  *....B@M..LavfWA
//   (15 49 A9 66 = Info, then BF 84 = CRC-32, four payload bytes).
//
// Lacing has no ffmpeg muxer option, so the three modes are built from their
// specified byte layouts in build_laced() and parsed through mk_open/mk_next.
// The file has an unknown-size Segment and two unknown-size Clusters: the
// first ends where the next Cluster begins, the second at the Segment end.
//
// Prints one PASS line per group and returns nonzero at the first failure.
// =======================================================

use "std/io.cst"      as io;
use "std/string.cst"  as str;
use "../container/ebml.cst"     as ebml;
use "../container/matroska.cst" as mk;
use "../core/errno.cst"         as errno;
use "../core/packet.cst"        as packet;

fn slen(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn weq(p as *u8, s as *u8, n as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (p[i] != s[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// ── synthetic EBML/Matroska builder ────────────────────────────────

fn w8(b as *u8, p as i64, v as i64) as i64 {
    b[p] = cast(u8, v & 255);
    return p + 1;
}

fn wbytes(b as *u8, p as i64, s as *u8, n as i64) as i64 {
    let is i64 as q with mut = p;
    let is i64 as i with mut = 0;
    while (i < n) { q = w8(b, q, cast(i64, s[i])); i = i + 1; }
    return q;
}

// Patch a reserved two-byte EBML size field (0x40 00 | n) after the body is
// written. All synthetic bodies are below 16384 bytes.
fn patch_size(b as *u8, sizeoff as i64, body as i64, p as i64) as void {
    let is i64 as n = p - body;
    b[sizeoff] = cast(u8, 64 | ((n >> 8) & 63));
    b[sizeoff + 1] = cast(u8, n & 255);
}

fn header_doc(b as *u8, start as i64, doctype as *u8, dtlen as i64,
              readver as i64) as i64 {
    let is i64 as p with mut = start;
    p = w8(b, p, 0x1A); p = w8(b, p, 0x45);
    p = w8(b, p, 0xDF); p = w8(b, p, 0xA3);
    let is i64 as so = p; p = w8(b, p, 0); p = w8(b, p, 0);
    let is i64 as bo = p;
    p = wbytes(b, p, "\x42\x86\x81\x01", 4);   // EBMLVersion 1
    p = wbytes(b, p, "\x42\xF7\x81\x01", 4);   // EBMLReadVersion 1
    p = wbytes(b, p, "\x42\xF2\x81\x04", 4);   // EBMLMaxIDLength 4
    p = wbytes(b, p, "\x42\xF3\x81\x08", 4);   // EBMLMaxSizeLength 8
    p = w8(b, p, 0x42); p = w8(b, p, 0x82);    // DocType
    p = w8(b, p, dtlen + 128);
    p = wbytes(b, p, doctype, dtlen);
    p = wbytes(b, p, "\x42\x87\x81\x02", 4);   // DocTypeVersion 2
    p = w8(b, p, 0x42); p = w8(b, p, 0x85);    // DocTypeReadVersion
    p = w8(b, p, 0x81); p = w8(b, p, readver);
    patch_size(b, so, bo, p);
    return p;
}

// One SimpleBlock element: track 1, relative timestamp, flags, the lacing
// header bytes, then the frame bytes.
fn simple_block(b as *u8, start as i64, rel as i64, flags as i64,
                lh as *u8, lh_len as i64, data as *u8, dlen as i64) as i64 {
    let is i64 as p with mut = start;
    p = w8(b, p, 0xA3);
    let is i64 as so = p; p = w8(b, p, 0); p = w8(b, p, 0);
    let is i64 as bo = p;
    p = w8(b, p, 0x81);
    p = w8(b, p, (rel >> 8) & 255);
    p = w8(b, p, rel & 255);
    p = w8(b, p, flags);
    p = wbytes(b, p, lh, lh_len);
    p = wbytes(b, p, data, dlen);
    patch_size(b, so, bo, p);
    return p;
}

// One BlockGroup: a Block with the same header layout as a SimpleBlock, plus
// BlockDuration in Timecode ticks. No ReferenceBlock, so it is a keyframe.
fn block_group(b as *u8, start as i64, rel as i64, flags as i64,
               lh as *u8, lh_len as i64, data as *u8, dlen as i64,
               dur_ticks as i64) as i64 {
    let is i64 as p with mut = start;
    p = w8(b, p, 0xA0);
    let is i64 as gso = p; p = w8(b, p, 0); p = w8(b, p, 0);
    let is i64 as gbo = p;

    p = w8(b, p, 0xA1);
    let is i64 as bso = p; p = w8(b, p, 0); p = w8(b, p, 0);
    let is i64 as bbo = p;
    p = w8(b, p, 0x81);
    p = w8(b, p, (rel >> 8) & 255);
    p = w8(b, p, rel & 255);
    p = w8(b, p, flags);
    p = wbytes(b, p, lh, lh_len);
    p = wbytes(b, p, data, dlen);
    patch_size(b, bso, bbo, p);

    p = wbytes(b, p, "\x9B\x81", 2);            // BlockDuration
    p = w8(b, p, dur_ticks);
    patch_size(b, gso, gbo, p);
    return p;
}

// A complete file with an unknown-size Segment, two unknown-size Clusters,
// and Xiph, fixed and EBML laced blocks plus one BlockGroup.
fn build_laced(b as *u8) as i64 {
    let is i64 as p with mut = 0;
    p = header_doc(b, p, "webm", 4, 2);

    // Segment with unknown size: 0x01 followed by seven 0xFF.
    p = wbytes(b, p, "\x18\x53\x80\x67\x01", 5);
    let is i64 as i with mut = 0;
    while (i < 7) { p = w8(b, p, 0xFF); i = i + 1; }

    // Info: TimecodeScale 1,000,000.
    p = wbytes(b, p, "\x15\x49\xA9\x66", 4);
    let is i64 as isz = p; p = w8(b, p, 0); p = w8(b, p, 0);
    let is i64 as ib = p;
    p = wbytes(b, p, "\x2A\xD7\xB1\x83\x0F\x42\x40", 7);
    patch_size(b, isz, ib, p);

    // Tracks: one Opus audio track, DefaultDuration 20 ms.
    p = wbytes(b, p, "\x16\x54\xAE\x6B", 4);
    let is i64 as tsz = p; p = w8(b, p, 0); p = w8(b, p, 0);
    let is i64 as tb = p;
    p = w8(b, p, 0xAE);
    let is i64 as esz = p; p = w8(b, p, 0); p = w8(b, p, 0);
    let is i64 as eb = p;
    p = wbytes(b, p, "\xD7\x81\x01", 3);                        // TrackNumber 1
    p = wbytes(b, p, "\x83\x81\x02", 3);                        // TrackType audio
    p = wbytes(b, p, "\x86\x86", 2);
    p = wbytes(b, p, "A_OPUS", 6);                              // CodecID
    p = wbytes(b, p, "\x9C\x81\x01", 3);                        // FlagLacing 1
    p = wbytes(b, p, "\x23\xE3\x83\x84\x01\x31\x2D\x00", 8);    // DefaultDuration
    p = w8(b, p, 0xE1);                                         // Audio
    let is i64 as asz = p; p = w8(b, p, 0); p = w8(b, p, 0);
    let is i64 as ab = p;
    p = w8(b, p, 0xB5); p = w8(b, p, 0x88);
    p = wbytes(b, p, "\x40\xE7\x70\x00\x00\x00\x00\x00", 8);    // 48000.0
    p = wbytes(b, p, "\x9F\x81\x02", 3);                        // Channels 2
    patch_size(b, asz, ab, p);
    patch_size(b, esz, eb, p);
    patch_size(b, tsz, tb, p);

    // Cluster 1, unknown size: Xiph, fixed and EBML lacing at t=0.
    p = wbytes(b, p, "\x1F\x43\xB6\x75\xFF", 5);
    p = wbytes(b, p, "\xE7\x81\x00", 3);                        // Timecode 0
    p = simple_block(b, p, 0, 0x82, "\x02\x03\x02", 3,
                     "AAABBCCCC", 9);                           // Xiph: 3,2,4
    p = simple_block(b, p, 0, 0x84, "\x02", 1,
                     "DDDEEEFFF", 9);                           // fixed: 3,3,3
    p = simple_block(b, p, 0, 0x06, "\x02\x83\xC1", 3,
                     "GGGHHHHHIIII", 12);                       // EBML: 3,5,4

    // Cluster 2, unknown size: ends at Segment end.
    p = wbytes(b, p, "\x1F\x43\xB6\x75\xFF", 5);
    p = wbytes(b, p, "\xE7\x81\x64", 3);                        // Timecode 100
    p = block_group(b, p, 0, 0x84, "\x02", 1, "JJJKKKLLL", 9, 60);
    p = simple_block(b, p, 50, 0x00, "", 0, "ZZZ", 3);          // t=150 ms
    return p;
}

// A Segment whose Tracks holds 65 TrackEntry elements: one past the fixed
// capacity. Every entry is a valid one-track body, so the failure is the
// count, not the entries.
fn build_track_overflow(b as *u8) as i64 {
    let is i64 as p with mut = 0;
    p = header_doc(b, p, "webm", 4, 2);
    p = wbytes(b, p, "\x18\x53\x80\x67", 4);
    let is i64 as ssz = p; p = w8(b, p, 0); p = w8(b, p, 0);
    let is i64 as sb = p;
    p = wbytes(b, p, "\x16\x54\xAE\x6B", 4);
    let is i64 as tsz = p; p = w8(b, p, 0); p = w8(b, p, 0);
    let is i64 as tb = p;
    let is i64 as i with mut = 0;
    while (i < 65) {
        p = wbytes(b, p, "\xAE\x83\xD7\x81\x01", 5);
        i = i + 1;
    }
    patch_size(b, tsz, tb, p);
    patch_size(b, ssz, sb, p);
    return p;
}

// ── groups ─────────────────────────────────────────────────────────

fn group_ebml() as i64 {
    let is *u8 as d with imut = "\x1A\x45\xDF\xA3\x84\x01\x02\x03\x04";
    let is ebml.Ebml as e;
    let is ebml.EbmlVint as v;
    let is ebml.EbmlElement as el;

    if (ebml.ebml_init(&e, d, 9) != 0) { return 1; }

    // ID keeps its marker bits; four bytes is the EBML maximum.
    if (ebml.ebml_read_vint(d, 0, 9, 1, &v) != 0) { return 2; }
    if (v.raw != 440786851) { return 3; }          // 0x1A45DFA3
    if (v.len != 4 || v.next != 4 || v.unknown != 0) { return 4; }

    // Size loses the marker; 0x84 is four bytes.
    if (ebml.ebml_read_vint(d, 4, 9, 0, &v) != 0) { return 5; }
    if (v.value != 4 || v.len != 1 || v.next != 5) { return 6; }
    if (v.unknown != 0) { return 7; }

    // All value bits set is the unknown-size sentinel.
    let is *u8 as unk with imut = "\xFF";
    if (ebml.ebml_read_vint(unk, 0, 1, 0, &v) != 0) { return 8; }
    if (v.unknown != 1 || v.value != 127) { return 9; }

    // Eight-byte size vint: the first byte is only the marker.
    let is *u8 as eight with imut = "\x01\x00\x00\x00\x00\x00\x00\x05";
    if (ebml.ebml_read_vint(eight, 0, 8, 0, &v) != 0) { return 10; }
    if (v.value != 5 || v.len != 8 || v.next != 8) { return 11; }
    let is *u8 as eightu with imut = "\x01\xFF\xFF\xFF\xFF\xFF\xFF\xFF";
    if (ebml.ebml_read_vint(eightu, 0, 8, 0, &v) != 0) { return 12; }
    if (v.unknown != 1) { return 13; }

    // A ten-byte-or-wider request (0x00) and a five-byte ID are corrupt;
    // a vint whose prefix promises more bytes than remain is EOF.
    let is *u8 as zero with imut = "\x00";
    if (ebml.ebml_read_vint(zero, 0, 1, 0, &v) != errno.I_CORRUPT) { return 14; }
    let is *u8 as short with imut = "\x40";
    if (ebml.ebml_read_vint(short, 0, 1, 0, &v) != errno.I_EOF) { return 15; }
    let is *u8 as longid with imut = "\x08\x00\x00\x00\x00";
    if (ebml.ebml_read_vint(longid, 0, 5, 1, &v) != errno.I_CORRUPT) { return 16; }

    // Element header, unsigned integer and string.
    if (ebml.ebml_read_element(&e, 0, 9, &el) != 0) { return 17; }
    if (el.id != 440786851 || el.size != 4 || el.off != 5) { return 18; }
    if (el.next != 9 || el.unknown != 0) { return 19; }

    let is *u8 as dnum with imut = "\x42\xF7\x81\x2A";
    if (ebml.ebml_init(&e, dnum, 4) != 0) { return 20; }
    if (ebml.ebml_read_element(&e, 0, 4, &el) != 0) { return 21; }
    let is i64 as n with mut = 0;
    if (ebml.ebml_uint(&e, &el, &n) != 0 || n != 42) { return 22; }

    // Signed two's complement: one byte 0xFE is -2.
    let is *u8 as dneg with imut = "\x42\xF7\x81\xFE";
    if (ebml.ebml_init(&e, dneg, 4) != 0) { return 23; }
    if (ebml.ebml_read_element(&e, 0, 4, &el) != 0) { return 24; }
    if (ebml.ebml_int(&e, &el, &n) != 0 || n != (0 - 2)) { return 25; }

    // String with NUL padding: "webm\0\0" trims to four bytes.
    let is *u8 as dstr with imut = "\x42\x82\x86\x77\x65\x62\x6D\x00\x00";
    if (ebml.ebml_init(&e, dstr, 9) != 0) { return 26; }
    if (ebml.ebml_read_element(&e, 0, 9, &el) != 0) { return 27; }
    if (ebml.ebml_str_eq(&e, &el, "webm") != 1) { return 28; }
    if (ebml.ebml_str_eq(&e, &el, "matroska") != 0) { return 29; }

    // Float32 and float64 big-endian, both 48000.0.
    let is *u8 as df32 with imut = "\x44\x89\x84\x47\x3B\x80\x00";
    if (ebml.ebml_init(&e, df32, 7) != 0) { return 30; }
    if (ebml.ebml_read_element(&e, 0, 7, &el) != 0) { return 31; }
    let is f64 as f with mut = 0.0;
    if (ebml.ebml_float(&e, &el, &f) != 0) { return 32; }
    if (f != 48000.0) { return 33; }

    let is *u8 as df64 with imut = "\x44\x89\x88\x40\xE7\x70\x00\x00\x00\x00\x00";
    if (ebml.ebml_init(&e, df64, 11) != 0) { return 34; }
    if (ebml.ebml_read_element(&e, 0, 11, &el) != 0) { return 35; }
    if (ebml.ebml_float(&e, &el, &f) != 0) { return 36; }
    if (f != 48000.0) { return 37; }

    // An unknown-size element cannot be stepped over by size.
    el.unknown = 1;
    let is i64 as cursor with mut = 0;
    if (ebml.ebml_element_skip(&el, &cursor) != errno.I_UNSUPPORTED) { return 38; }
    return 0;
}

fn open_vector(path as *u8, s as *str.String, m as *mk.Mk) as i64 {
    s[0] = io.read_file(str.String(path));
    if (cast(i64, s[0].ptr) == 0) { return errno.I_EOF; }
    return mk.mk_open(m, s[0].ptr, cast(i64, s[0].len));
}

fn group_vp9() as i64 {
    let is str.String as s;
    let is mk.Mk as m;
    let is i64 as r with mut = open_vector("tests/vectors/small/vp9_2f.webm", &s, &m);
    if (r != 0) { return 1; }
    if (mk.mk_track_count(&m) != 1) { return 2; }
    if (mk.mk_timecode_scale(&m) != 1000000) { return 3; }
    // ffprobe format duration=0.200000, stored as 200 ticks of 1 ms.
    if (mk.mk_duration(&m) != 200000000.0) { return 4; }

    let is *mk.MkTrack as t = mk.mk_track(&m, 0);
    if (cast(i64, t) == 0) { return 5; }
    if (t.number != 1) { return 6; }
    if (t.typ != mk.MK_TRACK_VIDEO) { return 7; }
    if (mk.mk_track_codec_eq(t, "V_VP9") != 1) { return 8; }
    if (t.pixel_width != 64 || t.pixel_height != 48) { return 9; }
    if (t.sample_rate != 0.0 || t.channels != 0) { return 10; }
    if (t.default_duration != 100000000) { return 11; }
    if (t.codec_delay != 0 || t.seek_pre_roll != 0) { return 12; }
    if (t.codec_priv_len != 0) { return 13; }

    let is packet.Packet as p;
    r = mk.mk_next(&m, &p);
    if (r != 1) { return 14; }
    if (p.track != 0 || p.len != 1192) { return 15; }
    if (p.pts != 0 || p.dts != 0) { return 16; }
    if (p.duration != 100000000) { return 17; }
    if (p.keyframe != 1) { return 18; }
    if (p.discard_padding != 0) { return 19; }
    if (cast(i64, p.data) == 0) { return 20; }

    r = mk.mk_next(&m, &p);
    if (r != 1) { return 21; }
    if (p.track != 0 || p.len != 38) { return 22; }
    if (p.pts != 100000000 || p.dts != 100000000) { return 23; }
    if (p.duration != 100000000) { return 24; }
    if (p.keyframe != 0) { return 25; }

    if (mk.mk_next(&m, &p) != 0) { return 26; }
    return 0;
}

fn group_opus() as i64 {
    let is str.String as s;
    let is mk.Mk as m;
    let is i64 as r with mut = open_vector("tests/vectors/small/opus_stereo.webm", &s, &m);
    if (r != 0) { return 1; }
    if (mk.mk_track_count(&m) != 1) { return 2; }
    if (mk.mk_timecode_scale(&m) != 1000000) { return 3; }
    // ffprobe format duration=0.208000, stored as 208 ticks of 1 ms.
    if (mk.mk_duration(&m) != 208000000.0) { return 4; }

    let is *mk.MkTrack as t = mk.mk_track(&m, 0);
    if (cast(i64, t) == 0) { return 5; }
    if (t.number != 1) { return 6; }
    if (t.typ != mk.MK_TRACK_AUDIO) { return 7; }
    if (mk.mk_track_codec_eq(t, "A_OPUS") != 1) { return 8; }
    if (t.sample_rate != 48000.0) { return 9; }
    if (t.channels != 2) { return 10; }
    if (t.default_duration != 20000000) { return 11; }
    if (t.codec_delay != 6500000) { return 12; }
    if (t.seek_pre_roll != 80000000) { return 13; }

    let is *u8 as head with imut =
        "\x4F\x70\x75\x73\x48\x65\x61\x64\x01\x02\x38\x01\x80\xBB\x00\x00\x00\x00\x00";
    if (t.codec_priv_len != 19) { return 14; }
    if (weq(t.codec_priv, head, 19) != 1) { return 15; }
    // Decode the fields the header spells out: version, channels, pre-skip,
    // input rate (little-endian), gain, mapping family.
    if (cast(i64, t.codec_priv[8]) != 1) { return 16; }
    if (cast(i64, t.codec_priv[9]) != 2) { return 17; }
    if ((cast(i64, t.codec_priv[10]) | (cast(i64, t.codec_priv[11]) << 8)) != 312) { return 18; }
    if ((cast(i64, t.codec_priv[12]) | (cast(i64, t.codec_priv[13]) << 8)
         | (cast(i64, t.codec_priv[14]) << 16)
         | (cast(i64, t.codec_priv[15]) << 24)) != 48000) { return 19; }
    if ((cast(i64, t.codec_priv[16]) | (cast(i64, t.codec_priv[17]) << 8)) != 0) { return 20; }
    if (cast(i64, t.codec_priv[18]) != 0) { return 21; }

    let is packet.Packet as p;
    let is i64 as i with mut = 0;
    while (i < 11) {
        r = mk.mk_next(&m, &p);
        if (r != 1) { return 22; }
        if (p.track != 0 || p.len != 120) { return 23; }
        let is i64 as pts with mut = 0;
        if (i > 0) { pts = 21000000 + (i - 1) * 20000000; }
        if (p.pts != pts || p.dts != pts) { return 24; }
        if (p.keyframe != 1) { return 25; }
        if (i < 10) {
            if (p.duration != 20000000) { return 26; }
            if (p.discard_padding != 0) { return 27; }
        } else {
            // Last BlockGroup: BlockDuration 7 ms, DiscardPadding 648
            // samples at 48 kHz = 13,500,000 ns.
            if (p.duration != 7000000) { return 28; }
            if (p.discard_padding != 13500000) { return 29; }
        }
        i = i + 1;
    }
    if (mk.mk_next(&m, &p) != 0) { return 30; }
    return 0;
}

fn group_crc32() as i64 {
    let is str.String as s;
    let is mk.Mk as m;
    let is i64 as r with mut = open_vector("tests/vectors/small/vp9_crc32.mkv", &s, &m);
    if (r != 0) { return 1; }
    if (mk.mk_track_count(&m) != 1) { return 2; }
    let is *mk.MkTrack as t = mk.mk_track(&m, 0);
    if (mk.mk_track_codec_eq(t, "V_VP9") != 1) { return 3; }
    if (t.pixel_width != 64 || t.pixel_height != 48) { return 4; }
    let is packet.Packet as p;
    if (mk.mk_next(&m, &p) != 1) { return 5; }
    if (p.len != 1192 || p.pts != 0 || p.keyframe != 1) { return 6; }
    if (mk.mk_next(&m, &p) != 0) { return 7; }

    // The Matroska file's Info carries a CRC-32 (0xBF) first child; the WebM
    // file's does not, since its muxer omits them. Both parse above.
    let is ebml.Ebml as e;
    let is ebml.EbmlElement as seg;
    let is ebml.EbmlElement as info;
    let is ebml.EbmlElement as crc;
    if (ebml.ebml_init(&e, s.ptr, cast(i64, s.len)) != 0) { return 8; }
    if (ebml.ebml_read_element(&e, 0, cast(i64, s.len), &seg) != 0) { return 9; }
    if (ebml.ebml_find(&e, seg.next, cast(i64, s.len), 0x18538067, &seg) != 1) { return 10; }
    if (ebml.ebml_find(&e, seg.off, seg.next, 0x1549A966, &info) != 1) { return 11; }
    if (ebml.ebml_find(&e, info.off, info.next, 0xBF, &crc) != 1) { return 12; }

    let is str.String as ws;
    let is mk.Mk as wm;
    r = open_vector("tests/vectors/small/vp9_2f.webm", &ws, &wm);
    if (r != 0) { return 13; }
    if (ebml.ebml_init(&e, ws.ptr, cast(i64, ws.len)) != 0) { return 14; }
    if (ebml.ebml_read_element(&e, 0, cast(i64, ws.len), &seg) != 0) { return 15; }
    if (ebml.ebml_find(&e, seg.next, cast(i64, ws.len), 0x18538067, &seg) != 1) { return 16; }
    if (ebml.ebml_find(&e, seg.off, seg.next, 0x1549A966, &info) != 1) { return 17; }
    if (ebml.ebml_find(&e, info.off, info.next, 0xBF, &crc) != 0) { return 18; }
    return 0;
}

// Feed one packet and compare it against the expected lace.
fn check_packet(m as *mk.Mk, p as *packet.Packet, size as i64, text as *u8,
                pts as i64, key as i64, dur as i64, code as i64) as i64 {
    let is i64 as r = mk.mk_next(m, p);
    if (r != 1) { return code; }
    if (p.len != size) { return code + 1; }
    if (p.track != 0) { return code + 2; }
    if (p.pts != pts || p.dts != pts) { return code + 3; }
    if (p.duration != dur) { return code + 4; }
    if (p.keyframe != key) { return code + 5; }
    if (p.discard_padding != 0) { return code + 6; }
    if (weq(p.data, text, size) != 1) { return code + 7; }
    return 0;
}

fn group_lacing() as i64 {
    let is [1024]u8 as buf;
    let is i64 as n = build_laced(cast(*u8, &buf));
    let is mk.Mk as m;
    let is i64 as r = mk.mk_open(&m, cast(*u8, &buf), n);
    if (r != 0) { return 1; }
    if (mk.mk_track_count(&m) != 1) { return 2; }
    let is *mk.MkTrack as t = mk.mk_track(&m, 0);
    if (t.default_duration != 20000000) { return 3; }

    let is packet.Packet as p;

    // Xiph lacing: 3, 2 and 4 bytes, pts stepping by DefaultDuration.
    if (check_packet(&m, &p, 3, "AAA", 0, 1, 20000000, 100) != 0) { return 100; }
    if (check_packet(&m, &p, 2, "BB", 20000000, 1, 20000000, 110) != 0) { return 110; }
    if (check_packet(&m, &p, 4, "CCCC", 40000000, 1, 20000000, 120) != 0) { return 120; }

    // Fixed-size lacing: three 3-byte frames.
    if (check_packet(&m, &p, 3, "DDD", 0, 1, 20000000, 130) != 0) { return 130; }
    if (check_packet(&m, &p, 3, "EEE", 20000000, 1, 20000000, 140) != 0) { return 140; }
    if (check_packet(&m, &p, 3, "FFF", 40000000, 1, 20000000, 150) != 0) { return 150; }

    // EBML lacing: 3, 5 and 4 bytes; not a keyframe.
    if (check_packet(&m, &p, 3, "GGG", 0, 0, 20000000, 160) != 0) { return 160; }
    if (check_packet(&m, &p, 5, "HHHHH", 20000000, 0, 20000000, 170) != 0) { return 170; }
    if (check_packet(&m, &p, 4, "IIII", 40000000, 0, 20000000, 180) != 0) { return 180; }

    // Second cluster (unknown size, ended by Segment end): BlockGroup with
    // BlockDuration 60 ticks over three fixed laces, then a plain block.
    if (check_packet(&m, &p, 3, "JJJ", 100000000, 1, 20000000, 190) != 0) { return 190; }
    if (check_packet(&m, &p, 3, "KKK", 120000000, 1, 20000000, 200) != 0) { return 200; }
    if (check_packet(&m, &p, 3, "LLL", 140000000, 1, 20000000, 210) != 0) { return 210; }
    if (check_packet(&m, &p, 3, "ZZZ", 150000000, 0, 20000000, 220) != 0) { return 220; }

    if (mk.mk_next(&m, &p) != 0) { return 230; }
    return 0;
}

fn group_reject() as i64 {
    let is ebml.Ebml as e;
    let is ebml.EbmlElement as el;
    let is ebml.EbmlVint as v;

    // A declared size larger than the parent/file is refused before use.
    let is *u8 as past with imut = "\x1A\x45\xDF\xA3\x88\x00";
    if (ebml.ebml_init(&e, past, 6) != 0) { return 1; }
    if (ebml.ebml_read_element(&e, 0, 6, &el) != errno.I_CORRUPT) { return 2; }

    // A size vint whose prefix promises bytes that are not there is EOF.
    let is *u8 as cut with imut = "\x1A\x45\xDF\xA3\x40";
    if (ebml.ebml_init(&e, cut, 5) != 0) { return 3; }
    if (ebml.ebml_read_element(&e, 0, 5, &el) != errno.I_EOF) { return 4; }

    // A vint with no terminator bit at all.
    let is *u8 as noterm with imut = "\x00\x00";
    if (ebml.ebml_read_vint(noterm, 0, 2, 0, &v) != errno.I_CORRUPT) { return 5; }

    // DocType other than webm/matroska, and a read version above 4.
    let is [256]u8 as buf;
    let is i64 as n with mut = header_doc(cast(*u8, &buf), 0, "avi ", 4, 2);
    let is i64 as p with mut = wbytes(cast(*u8, &buf), n, "\x18\x53\x80\x67\x80", 5);
    let is mk.Mk as m;
    if (mk.mk_open(&m, cast(*u8, &buf), p) != errno.I_BADMAGIC) { return 6; }

    n = header_doc(cast(*u8, &buf), 0, "webm", 4, 5);
    p = wbytes(cast(*u8, &buf), n, "\x18\x53\x80\x67\x80", 5);
    if (mk.mk_open(&m, cast(*u8, &buf), p) != errno.I_UNSUPPORTED) { return 7; }

    // A truncated real file must not parse.
    let is str.String as s with mut;
    s = io.read_file(str.String("tests/vectors/small/vp9_2f.webm"));
    if (cast(i64, s.ptr) == 0) { return 8; }
    if (mk.mk_open(&m, s.ptr, cast(i64, s.len) - 8) >= 0) { return 9; }

    // 65 TrackEntry elements: the fixed capacity is 64, so the count is
    // refused before the 65th is written.
    let is [1024]u8 as big;
    n = build_track_overflow(cast(*u8, &big));
    if (mk.mk_open(&m, cast(*u8, &big), n) != errno.I_CORRUPT) { return 10; }
    if (mk.mk_track_count(&m) != 0) { return 11; }
    let is packet.Packet as pkt;
    if (mk.mk_next(&m, &pkt) != 0) { return 12; }
    return 0;
}

// ── main ───────────────────────────────────────────────────────────

fn failed(name as *u8, code as i64) as i32 {
    io.write_str(1, "FAIL ");
    io.write_str(1, name);
    io.write_str(1, " at ");
    io.write_int(1, code);
    io.write_str(1, "\n");
    return 1;
}

fn main() as i32 {
    let is i64 as rc with mut = 0;

    rc = group_ebml();
    if (rc != 0) { return failed("ebml", rc); }
    io.write_str(1, "PASS ebml\n");

    rc = group_vp9();
    if (rc != 0) { return failed("vp9", rc); }
    io.write_str(1, "PASS vp9\n");

    rc = group_opus();
    if (rc != 0) { return failed("opus", rc); }
    io.write_str(1, "PASS opus\n");

    rc = group_crc32();
    if (rc != 0) { return failed("crc32", rc); }
    io.write_str(1, "PASS crc32\n");

    rc = group_lacing();
    if (rc != 0) { return failed("lacing", rc); }
    io.write_str(1, "PASS lacing\n");

    rc = group_reject();
    if (rc != 0) { return failed("reject", rc); }
    io.write_str(1, "PASS reject\n");

    return 0;
}
