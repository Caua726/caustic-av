// =======================================================
// tests/test_core.cst
// Tests for the invariants later codecs depend on, not per-function coverage:
// a failed read leaves the cursor/bit position alone, allocation sizes are
// checked before any memory is touched, and a few bit/endian results that
// would silently decode video wrong if the direction were reversed.
//
// Prints one PASS line per group and returns nonzero on the first failure.
// =======================================================

use "std/io.cst"   as io;
use "../core/buf.cst"     as buf;
use "../core/bits.cst"    as bits;
use "../core/packet.cst"  as packet;
use "../core/frame.cst"   as frame;
use "../core/samples.cst" as samples;
use "../core/errno.cst"   as errno;

fn group_buf() as i64 {
    let is *u8 as d with imut = "\x01\x02\x03\x04\x05\x06\x07\x08";
    let is buf.Buf as b;

    // Endianness and width, on known byte patterns.
    buf.buf_init(&b, d, 8);
    if (buf.buf_u32le(&b) != 67305985) { return 1; }        // 0x04030201
    if (buf.buf_u16be(&b) != 1286)     { return 2; }        // 0x0506
    if (buf.buf_u16le(&b) != 2055)     { return 3; }        // 0x0807

    buf.buf_init(&b, d, 8);
    if (buf.buf_u24le(&b) != 197121)   { return 4; }        // 0x030201
    if (buf.buf_u24be(&b) != 263430)   { return 5; }        // 0x040506

    buf.buf_init(&b, d, 8);
    if (buf.buf_u64le(&b) != 578437695752307201)  { return 6; }
    buf.buf_init(&b, d, 8);
    if (buf.buf_u64be(&b) != 72623859790382856)   { return 7; }

    // A short read is I_EOF and does not advance the cursor.
    buf.buf_init(&b, d, 2);
    if (buf.buf_u32le(&b) >= 0) { return 8; }
    if (buf.buf_pos(&b) != 0)   { return 9; }
    if (buf.buf_u8(&b) != 1)    { return 10; }
    if (buf.buf_u16be(&b) >= 0) { return 11; }               // one byte left
    if (buf.buf_pos(&b) != 1)   { return 12; }

    // Seek and skip reject out-of-range positions without moving.
    buf.buf_init(&b, d, 8);
    if (buf.buf_seek(&b, 9) >= 0)  { return 13; }
    if (buf.buf_pos(&b) != 0)      { return 14; }
    if (buf.buf_seek(&b, 8) != 0)  { return 15; }
    if (buf.buf_skip(&b, 1) >= 0)  { return 16; }
    if (buf.buf_pos(&b) != 8)      { return 17; }
    if (buf.buf_at(&b, 7) != 8)    { return 18; }
    if (buf.buf_at(&b, 8) >= 0)    { return 19; }
    if (buf.buf_peek(&b, 0 - 1) >= 0) { return 20; }
    return 0;
}

fn group_bits() as i64 {
    let is *u8 as d with imut = "\xb2\x61";                  // 1011 0010 0110 0001
    let is bits.BitsMsb as m;
    if (bits.bits_msb_init(&m, d, 2) != 0) { return 1; }
    if (bits.bits_msb_remaining(&m) != 16) { return 2; }
    if (bits.bits_msb_read(&m, 3) != 5)    { return 3; }     // 101
    if (bits.bits_msb_read(&m, 6) != 36)   { return 4; }     // 100100, crosses the byte
    if (bits.bits_msb_read(&m, 7) != 97)   { return 5; }     // 1100001
    if (bits.bits_msb_consumed(&m) != 16)  { return 6; }

    // Exhausted: a read is I_EOF and consumes nothing.
    if (bits.bits_msb_read(&m, 1) >= 0)    { return 7; }
    if (bits.bits_msb_consumed(&m) != 16)  { return 8; }

    let is bits.BitsLsb as l;
    if (bits.bits_lsb_init(&l, d, 2) != 0) { return 9; }
    if (bits.bits_lsb_read(&l, 3) != 2)    { return 10; }    // 0,1,0
    if (bits.bits_lsb_read(&l, 6) != 54)   { return 11; }    // crosses the byte
    if (bits.bits_lsb_read(&l, 7) != 48)   { return 12; }

    // ue: 0, 1, 2, 3, 4 encoded as 1 010 011 00100 00101.
    let is *u8 as u with imut = "\xa6\x42\x80";
    if (bits.bits_msb_init(&m, u, 3) != 0) { return 13; }
    if (bits.bits_msb_ue(&m) != 0) { return 14; }
    if (bits.bits_msb_ue(&m) != 1) { return 15; }
    if (bits.bits_msb_ue(&m) != 2) { return 16; }
    if (bits.bits_msb_ue(&m) != 3) { return 17; }
    if (bits.bits_msb_ue(&m) != 4) { return 18; }

    // se: 0, 1, -1, 2, -2 from the same bit string.
    let is i64 as sv with mut = 0;
    if (bits.bits_msb_init(&m, u, 3) != 0) { return 19; }
    if (bits.bits_msb_se(&m, &sv) != 0 || sv != 0)  { return 20; }
    if (bits.bits_msb_se(&m, &sv) != 0 || sv != 1)  { return 21; }
    if (bits.bits_msb_se(&m, &sv) != 0 || sv != (0 - 1)) { return 22; }
    if (bits.bits_msb_se(&m, &sv) != 0 || sv != 2)  { return 23; }
    if (bits.bits_msb_se(&m, &sv) != 0 || sv != (0 - 2)) { return 24; }

    // 64-bit read keeps all bits, including bit 63.
    let is *u8 as ones with imut = "\xff\xff\xff\xff\xff\xff\xff\xff";
    let is i64 as wide with mut = 0;
    if (bits.bits_msb_init(&m, ones, 8) != 0) { return 25; }
    if (bits.bits_msb_read_wide(&m, 64, &wide) != 0) { return 26; }
    if (wide != (0 - 1)) { return 27; }
    if (bits.bits_msb_remaining(&m) != 0) { return 28; }
    return 0;
}

fn group_frame() as i64 {
    // 4x2 I420: 8 luma bytes plus two 2x1 chroma planes.
    let is [12]u8 as mem;
    let is frame.Frame as f;
    if (frame.frame_size(4, 2) != 12) { return 1; }
    if (frame.frame_init(&f, 4, 2, cast(*u8, &mem), 12) != 0) { return 2; }
    if (f.stride_y != 4 || f.stride_u != 2 || f.stride_v != 2) { return 3; }
    if (cast(i64, f.y) != cast(i64, cast(*u8, &mem)))     { return 4; }
    if (cast(i64, f.u) != cast(i64, cast(*u8, &mem)) + 8) { return 5; }
    if (cast(i64, f.v) != cast(i64, cast(*u8, &mem)) + 10) { return 6; }

    // Coded larger than visible: VP9 superblock padding.
    let is [36]u8 as padded;
    if (frame.frame_size(6, 4) != 36) { return 7; }
    if (frame.frame_init_coded(&f, 4, 2, 6, 4, cast(*u8, &padded), 36) != 0) { return 8; }
    if (f.width != 4 || f.height != 2) { return 9; }
    if (f.coded_width != 6 || f.coded_height != 4) { return 10; }
    if (f.stride_y != 6) { return 11; }
    if (cast(i64, f.u) != cast(i64, cast(*u8, &padded)) + 24) { return 12; }
    if (cast(i64, f.v) != cast(i64, cast(*u8, &padded)) + 30) { return 13; }

    // A short block is refused before any pointer is published.
    if (frame.frame_init(&f, 4, 2, cast(*u8, &mem), 11) != errno.I_NOMEM) { return 14; }
    if (cast(i64, f.y) != 0) { return 15; }

    // Oversized and degenerate dimensions are refused, never multiplied.
    if (frame.frame_size(65537, 1) != errno.I_DIMS) { return 16; }
    if (frame.frame_size(0, 1) != errno.I_DIMS)     { return 17; }
    if (frame.frame_size(65536, 65536) != 6442450944) { return 18; }

    frame.frame_free(&f);
    if (cast(i64, f.pixels) != 0 || f.cap != 0 || f.width != 0) { return 19; }
    return 0;
}

fn group_samples() as i64 {
    let is [16]u8 as mem;
    let is samples.Samples as s;
    if (samples.samples_size(samples.SAMPLE_FMT_S16, 2, 4) != 16) { return 1; }
    if (samples.samples_init(&s, samples.SAMPLE_FMT_S16, 48000, 2, 4,
                             cast(*u8, &mem), 16) != 0) { return 2; }
    if (s.rate != 48000 || s.channels != 2 || s.count != 4) { return 3; }
    if (cast(i64, s.data) != cast(i64, cast(*u8, &mem))) { return 4; }

    if (samples.samples_init(&s, samples.SAMPLE_FMT_S16, 48000, 2, 4,
                             cast(*u8, &mem), 15) != errno.I_NOMEM) { return 5; }
    if (cast(i64, s.data) != 0) { return 6; }

    samples.samples_free(&s);
    if (s.count != 0 || s.cap != 0) { return 7; }
    return 0;
}

fn group_packet() as i64 {
    let is *u8 as d with imut = "\x01\x02\x03\x04";
    let is packet.Packet as p;
    if (packet.packet_set(&p, d, 4, 3, 100, 90, 20, 7) != 0) { return 1; }
    if (p.len != 4 || p.track != 3) { return 2; }
    if (p.pts != 100 || p.dts != 90 || p.duration != 20) { return 3; }
    if (packet.packet_is_key(&p) != 1) { return 4; }
    if (cast(i64, p.data) != cast(i64, d)) { return 5; }

    if (packet.packet_set(&p, d, 0 - 1, 0, 0, 0, 0, 0) != errno.I_BADPARAM) { return 6; }
    if (p.len != 4 || p.track != 3) { return 7; }

    packet.packet_clear(&p);
    if (p.track != 0 || packet.packet_len(&p) != 0) { return 8; }
    return 0;
}

fn failed(name as *u8, code as i64) as i32 {
    io.write_str(1, "FAIL ");
    io.write_str(1, name);
    io.write_str(1, " at ");
    io.write_int(1, code);
    io.write_str(1, "\n");
    return 1;
}

fn main() as i32 {
    let is i64 as rc with mut = 0;

    rc = group_buf();
    if (rc != 0) { return failed("buf", rc); }
    io.write_str(1, "PASS buf\n");

    rc = group_bits();
    if (rc != 0) { return failed("bits", rc); }
    io.write_str(1, "PASS bits\n");

    rc = group_frame();
    if (rc != 0) { return failed("frame", rc); }
    io.write_str(1, "PASS frame\n");

    rc = group_samples();
    if (rc != 0) { return failed("samples", rc); }
    io.write_str(1, "PASS samples\n");

    rc = group_packet();
    if (rc != 0) { return failed("packet", rc); }
    io.write_str(1, "PASS packet\n");

    return 0;
}
