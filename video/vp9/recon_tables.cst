// =======================================================
// caustic-av/video/vp9/recon_tables.cst
// Constants and lookup data used by the VP9 reconstruction kernels
// (transforms, intra prediction, loop filter). Everything here is the 8-bit
// path: the frame type this library decodes is 8-bit I420 (core/frame.cst),
// so the spec's dc_qlookup/ac_qlookup row for BitDepth 8 is the only row
// carried. A 10- or 12-bit frame (VP9 profile 2) is not representable and the
// decoder must refuse it with I_UNSUPPORTED before reaching these kernels.
//
// Provenance:
//   cos64_lookup, dc_qlookup[0], ac_qlookup[0]
//       VP9 Bitstream & Decoding Process Specification v0.6, sections 8.7.1.1
//       and 8.6.1. The two quant tables are stored as the spec's decimal
//       values in a compact text blob (recon_qvalue decodes it); the cosine
//       table is a 2-byte little-endian blob. Both are committed source:
//       nothing is generated or left pending.
//   block and transform size tables
//       Spec sections 6.4.10 (max_txsize_lookup), 6.4.22 (get_uv_tx_size),
//       6.4.23 (ss_size_lookup) and 10.2 (the four num_*_blocks_* lookups).
//       The conversion tables and max_txsize_lookup are the spec's printed
//       13-entry arrays, written as conditionals so every entry stays visible
//       and auditable. The 4x4-unit and 8x8-unit counts are separate helpers:
//       they are different numbers for the same block, and mixing them
//       silently changes the loop filter's block-edge modulus. get_uv_tx_size
//       is reproduced geometrically from the 4x4 counts for the 4:2:0 case
//       this decoder accepts. Blocks smaller than 8x8 return TX_4X4 before the
//       tables are consulted, as the spec requires, because their
//       ss_size_lookup entries are BLOCK_INVALID.
//
// The loop filter needs no numeric table: sections 8.8.3 and 8.8.4 define
// filter size, limit, blimit and thresh arithmetically (the masks are
// computed from samples), so no limit/blimit table is carried here. The
// libvpx lfthr tables are an optimisation of the same formulas, not data.
// =======================================================

// ── spec mathematical helpers (section 4.6) ─────────────────────────
//
// Shared by the transform, prediction and loop filter kernels so the
// rounding and clipping rules exist in one place. n >= 1 at every call.
fn recon_round2(x as i64, n as i64) as i64 {
    return (x + (1 << (n - 1))) >> n;
}

fn recon_clip3(lo as i64, hi as i64, v as i64) as i64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

// Clip1 for BitDepth 8.
fn recon_clip1(x as i64) as i64 {
    return recon_clip3(0, 255, x);
}

fn recon_abs(x as i64) as i64 {
    if (x < 0) { return 0 - x; }
    return x;
}

// ── transform sizes (spec: TX_SIZES) ────────────────────────────────
let is i64 as TX_4X4   with imut = 0;
let is i64 as TX_8X8   with imut = 1;
let is i64 as TX_16X16 with imut = 2;
let is i64 as TX_32X32 with imut = 3;

// ── transform types (spec: DCT_DCT..ADST_ADST) ──────────────────────
let is i64 as TXT_DCT_DCT   with imut = 0;   // rows DCT,    columns DCT
let is i64 as TXT_ADST_DCT  with imut = 1;   // rows DCT,    columns ADST
let is i64 as TXT_DCT_ADST  with imut = 2;   // rows ADST,   columns DCT
let is i64 as TXT_ADST_ADST with imut = 3;   // rows ADST,   columns ADST

// ── block sizes (spec section 6.4, BLOCK_SIZES order) ───────────────
let is i64 as BLOCK_4X4   with imut = 0;
let is i64 as BLOCK_4X8   with imut = 1;
let is i64 as BLOCK_8X4   with imut = 2;
let is i64 as BLOCK_8X8   with imut = 3;
let is i64 as BLOCK_8X16  with imut = 4;
let is i64 as BLOCK_16X8  with imut = 5;
let is i64 as BLOCK_16X16 with imut = 6;
let is i64 as BLOCK_16X32 with imut = 7;
let is i64 as BLOCK_32X16 with imut = 8;
let is i64 as BLOCK_32X32 with imut = 9;
let is i64 as BLOCK_32X64 with imut = 10;
let is i64 as BLOCK_64X32 with imut = 11;
let is i64 as BLOCK_64X64 with imut = 12;

// ── loop filter limits (spec sections 3 and 8.8) ────────────────────
let is i64 as MAX_SEGMENTS       with imut = 8;
let is i64 as MAX_REF_FRAMES     with imut = 4;
let is i64 as MAX_MODE_LF_DELTAS with imut = 2;
let is i64 as MAX_LOOP_FILTER    with imut = 63;

// Reference frame indices (spec: INTRA_FRAME, LAST_FRAME, GOLDEN_FRAME,
// ALTREF_FRAME). Only INTRA_FRAME is named here; the others are their
// numeric position 1..3.
let is i64 as INTRA_FRAME with imut = 0;

// ── prediction modes (spec section 3, y_mode ordering) ──────────────
let is i64 as MODE_DC    with imut = 0;
let is i64 as MODE_V     with imut = 1;
let is i64 as MODE_H     with imut = 2;
let is i64 as MODE_D45   with imut = 3;
let is i64 as MODE_D135  with imut = 4;
let is i64 as MODE_D117  with imut = 5;
let is i64 as MODE_D153  with imut = 6;
let is i64 as MODE_D207  with imut = 7;
let is i64 as MODE_D63   with imut = 8;
let is i64 as MODE_TM    with imut = 9;
let is i64 as MODE_NEARESTMV with imut = 10;
let is i64 as MODE_NEARMV    with imut = 11;
let is i64 as MODE_ZEROMV    with imut = 12;
let is i64 as MODE_NEWMV     with imut = 13;

// ── dequantisation tables (spec 8.6.1, BitDepth 8 row) ──────────────
//
// dc_qlookup[0][0..255] and ac_qlookup[0][0..255], in index order, as the
// decimals printed by the specification. recon_qvalue walks the blob, so the
// values stay auditable against the spec text instead of being encoded as
// bytes. Both tables hold 256 entries; the final entry has no trailing comma.
let is *u8 as DC_Q8 with imut = "4,8,8,9,10,11,12,12,13,14,15,16,17,18,19,19,20,21,22,23,24,25,26,26,27,28,29,30,31,32,32,33,34,35,36,37,38,38,39,40,41,42,43,43,44,45,46,47,48,48,49,50,51,52,53,53,54,55,56,57,57,58,59,60,61,62,62,63,64,65,66,66,67,68,69,70,70,71,72,73,74,74,75,76,77,78,78,79,80,81,81,82,83,84,85,85,87,88,90,92,93,95,96,98,99,101,102,104,105,107,108,110,111,113,114,116,117,118,120,121,123,125,127,129,131,134,136,138,140,142,144,146,148,150,152,154,156,158,161,164,166,169,172,174,177,180,182,185,187,190,192,195,199,202,205,208,211,214,217,220,223,226,230,233,237,240,243,247,250,253,257,261,265,269,272,276,280,284,288,292,296,300,304,309,313,317,322,326,330,335,340,344,349,354,359,364,369,374,379,384,389,395,400,406,411,417,423,429,435,441,447,454,461,467,475,482,489,497,505,513,522,530,539,549,559,569,579,590,602,614,626,640,654,668,684,700,717,736,755,775,796,819,843,869,896,925,955,988,1022,1058,1098,1139,1184,1232,1282,1336";

let is *u8 as AC_Q8 with imut = "4,12,18,25,33,41,50,60,70,80,91,103,115,127,140,153,166,180,194,208,222,237,251,266,281,296,312,327,343,358,374,390,405,421,437,453,469,484,500,516,532,548,564,580,596,611,627,643,659,674,690,706,721,737,752,768,783,798,814,829,844,859,874,889,904,919,934,949,964,978,993,1008,1022,1037,1051,1065,1080,1094,1108,1122,1136,1151,1165,1179,1192,1206,1220,1234,1248,1261,1275,1288,1302,1315,1329,1342,1368,1393,1419,1444,1469,1494,1519,1544,1569,1594,1618,1643,1668,1692,1717,1741,1765,1789,1814,1838,1862,1885,1909,1933,1957,1992,2027,2061,2096,2130,2165,2199,2233,2267,2300,2334,2367,2400,2434,2467,2499,2532,2575,2618,2661,2704,2746,2788,2830,2872,2913,2954,2995,3036,3076,3127,3177,3226,3275,3324,3373,3421,3469,3517,3565,3621,3677,3733,3788,3843,3897,3951,4005,4058,4119,4181,4241,4301,4361,4420,4479,4546,4612,4677,4742,4807,4871,4942,5013,5083,5153,5222,5291,5367,5442,5517,5591,5665,5745,5825,5905,5984,6063,6149,6234,6319,6404,6495,6587,6678,6769,6867,6966,7064,7163,7269,7376,7483,7599,7715,7832,7958,8085,8214,8352,8492,8635,8788,8945,9104,9275,9450,9639,9832,10031,10245,10465,10702,10946,11210,11482,11776,12081,12409,12750,13118,13501,13913,14343,14807,15290,15812,16356,16943,17575,18237,18949,19718,20521,21387";

// Decode entry `idx` of a comma-separated decimal blob. Values are separated
// by a single comma and contain no spaces; the blob ends with a NUL from its
// string literal. Out-of-range indices must be clipped by the caller.
fn recon_qvalue(s as *u8, idx as i64) as i64 {
    let is i64 as i with mut = 0;    // byte position in the blob
    let is i64 as k with mut = 0;    // entry being decoded
    if (idx < 0) { return 0; }
    while (k < idx) {
        if (cast(i64, s[i]) == 0) { return 0; }
        if (cast(i64, s[i]) == 44) { k = k + 1; }    // ','
        i = i + 1;
    }
    let is i64 as v with mut = 0;
    while (cast(i64, s[i]) != 0 && cast(i64, s[i]) != 44) {
        v = v * 10 + (cast(i64, s[i]) - 48);
        i = i + 1;
    }
    return v;
}

// dc_q(b) for BitDepth 8: dc_qlookup[0][Clip3(0,255,b)].
fn recon_dc_quant(b as i64) as i64 {
    let is i64 as q with mut = b;
    if (q < 0) { q = 0; }
    if (q > 255) { q = 255; }
    return recon_qvalue(DC_Q8, q);
}

// ac_q(b) for BitDepth 8: ac_qlookup[0][Clip3(0,255,b)].
fn recon_ac_quant(b as i64) as i64 {
    let is i64 as q with mut = b;
    if (q < 0) { q = 0; }
    if (q > 255) { q = 255; }
    return recon_qvalue(AC_Q8, q);
}

// ── cosine table (spec 8.7.1.1) ─────────────────────────────────────
//
// cos64_lookup[0..32] as 2-byte little-endian words, 16384 down to 0. The
// blob is 66 bytes; recon_cos64 below is the spec's cos64().
let is *u8 as COS64 with imut = "\x00\x40\xEC\x3F\xB1\x3F\x4F\x3F\xC5\x3E\x15\x3E\x3F\x3D\x42\x3C\x21\x3B\xDB\x39\x71\x38\xE5\x36\x37\x35\x68\x33\x79\x31\x6C\x2F\x41\x2D\xFB\x2A\x9A\x28\x20\x26\x8E\x23\xE7\x20\x2B\x1E\x5D\x1B\x7E\x18\x90\x15\x94\x12\x8D\x0F\x7C\x0C\x64\x09\x46\x06\x24\x03\x00\x00";

// A 16-bit little-endian word from `p` at byte offset `off`.
fn recon_word16(p as *u8, off as i64) as i64 {
    return cast(i64, p[off]) | (cast(i64, p[off + 1]) << 8);
}

// cos64(angle) for any integer angle: the spec reduces it to 0..127 and then
// reflects it into the 0..32 table, negating for the second and third
// quadrants. The reduction is written as a signed remainder so negative
// angles (the ADST16 uses -4 and -20) do not depend on bitwise semantics.
fn recon_cos64(angle as i64) as i64 {
    let is i64 as a with mut = angle % 128;
    if (a < 0) { a = a + 128; }
    if (a <= 32) { return recon_word16(COS64, a * 2); }
    if (a <= 64) { return 0 - recon_word16(COS64, (64 - a) * 2); }
    if (a <= 96) { return 0 - recon_word16(COS64, (a - 64) * 2); }
    return recon_word16(COS64, (128 - a) * 2);
}

// sin64(angle) = cos64(angle - 32). Written as angle + 96 so the argument
// stays non-negative and the modulo is taken by cos64's own mask.
fn recon_sin64(angle as i64) as i64 {
    return recon_cos64(angle + 96);
}

// ── block geometry (spec 6.4.10, 6.4.22, 6.4.23, 10.2) ──────────────
//
// Section 10.2 prints four block-size tables and 6.4.10 prints
// max_txsize_lookup; they are written here as conditionals over the 13
// BLOCK_* values, in the spec's order. Two unit systems are kept apart on
// purpose:
//   * num_4x4_blocks_*: how many 4x4 samples a block spans; this is the unit
//     of get_plane_block_size (6.4.23).
//   * num_8x8_blocks_*: how many 8x8 mode-info units it spans. Section 8.8
//     step 10 multiplies these by 8 to get a sample modulus, so a wrong unit
//     here disables valid loop-filter block edges rather than merely reading
//     the wrong geometry.

// num_8x8_blocks_wide_lookup[bs] (spec 10.2), for bs in 0..12. Returns 0
// outside that range so a caller can reject the value instead of treating it
// as a full superblock.
fn recon_num_8x8_wide(bs as i64) as i64 {
    if (bs < 0 || bs > BLOCK_64X64) { return 0; }
    if (bs <= BLOCK_8X16) { return 1; }     // 4X4, 4X8, 8X4, 8X8, 8X16
    if (bs <= BLOCK_16X32) { return 2; }    // 16X8, 16X16, 16X32
    if (bs <= BLOCK_32X64) { return 4; }    // 32X16, 32X32, 32X64
    return 8;                               // 64X32, 64X64
}

// num_8x8_blocks_high_lookup[bs] (spec 10.2).
fn recon_num_8x8_high(bs as i64) as i64 {
    if (bs < 0 || bs > BLOCK_64X64) { return 0; }
    if (bs == BLOCK_8X16) { return 2; }
    if (bs == BLOCK_16X8) { return 1; }
    if (bs == BLOCK_16X16) { return 2; }
    if (bs == BLOCK_16X32) { return 4; }
    if (bs == BLOCK_32X16) { return 2; }
    if (bs == BLOCK_32X32) { return 4; }
    if (bs == BLOCK_32X64) { return 8; }
    if (bs == BLOCK_64X32) { return 4; }
    if (bs == BLOCK_64X64) { return 8; }
    return 1;                               // 4X4, 4X8, 8X4, 8X8
}

// num_4x4_blocks_wide_lookup[bs] (spec 10.2), in 4x4 sample units.
fn recon_num_4x4_wide(bs as i64) as i64 {
    if (bs < 0 || bs > BLOCK_64X64) { return 0; }
    if (bs <= BLOCK_4X8) { return 1; }      // 4X4, 4X8
    if (bs <= BLOCK_8X16) { return 2; }     // 8X4, 8X8, 8X16
    if (bs <= BLOCK_16X32) { return 4; }    // 16X8, 16X16, 16X32
    if (bs <= BLOCK_32X64) { return 8; }    // 32X16, 32X32, 32X64
    return 16;                              // 64X32, 64X64
}

// num_4x4_blocks_high_lookup[bs] (spec 10.2), in 4x4 sample units.
fn recon_num_4x4_high(bs as i64) as i64 {
    if (bs < 0 || bs > BLOCK_64X64) { return 0; }
    if (bs == BLOCK_4X8) { return 2; }
    if (bs == BLOCK_8X4) { return 1; }
    if (bs == BLOCK_8X8) { return 2; }
    if (bs == BLOCK_8X16) { return 4; }
    if (bs == BLOCK_16X8) { return 2; }
    if (bs == BLOCK_16X16) { return 4; }
    if (bs == BLOCK_16X32) { return 8; }
    if (bs == BLOCK_32X16) { return 4; }
    if (bs == BLOCK_32X32) { return 8; }
    if (bs == BLOCK_32X64) { return 16; }
    if (bs == BLOCK_64X32) { return 8; }
    if (bs == BLOCK_64X64) { return 16; }
    return 1;                               // 4X4
}

// max_txsize_lookup[bs] (spec 6.4.10): the largest transform a block allows.
// This is the spec's direct 13-entry table; deriving it from the block's
// dimensions is not equivalent. Max(width, height), for example, would give
// 4X8 and 8X4 a TX_8X8 entry where the spec has TX_4X4, and Min in either
// unit system is wrong for other non-square shapes. Out-of-range bs maps to
// TX_4X4, the smallest entry, so a caller that forgot to validate cannot ask
// for a transform larger than the block.
fn recon_max_txsize(bs as i64) as i64 {
    if (bs < BLOCK_8X8) { return TX_4X4; }       // 4X4, 4X8, 8X4
    if (bs <= BLOCK_16X8) { return TX_8X8; }     // 8X8, 8X16, 16X8
    if (bs <= BLOCK_32X16) { return TX_16X16; }  // 16X16, 16X32, 32X16
    if (bs <= BLOCK_64X64) { return TX_32X32; }  // 32X32..64X64
    return TX_4X4;                               // out of range
}

// Block size from a width and height in 4x4 sample units (the units of
// num_4x4_blocks_*, not 8x8 mode-info units). Only the shapes the spec
// defines are produced. Callers pass a valid 4:2:0 plane block: a pair that
// no BLOCK_* describes (which only an invalid ss_size_lookup cell can
// produce) is not meaningful here.
fn recon_block_from_units(w as i64, h as i64) as i64 {
    if (w <= 1 && h <= 1) { return BLOCK_4X4; }
    if (w <= 1 && h <= 2) { return BLOCK_4X8; }
    if (w <= 2 && h <= 1) { return BLOCK_8X4; }
    if (w <= 2 && h <= 2) { return BLOCK_8X8; }
    if (w <= 2 && h <= 4) { return BLOCK_8X16; }
    if (w <= 4 && h <= 2) { return BLOCK_16X8; }
    if (w <= 4 && h <= 4) { return BLOCK_16X16; }
    if (w <= 4 && h <= 8) { return BLOCK_16X32; }
    if (w <= 8 && h <= 4) { return BLOCK_32X16; }
    if (w <= 8 && h <= 8) { return BLOCK_32X32; }
    if (w <= 8 && h <= 16) { return BLOCK_32X64; }
    if (w <= 16 && h <= 8) { return BLOCK_64X32; }
    return BLOCK_64X64;
}

// get_uv_tx_size (spec 6.4.22): the chroma transform size for a luma block of
// `bs` and luma transform `tx_size` under the frame's subsampling. A luma
// block smaller than 8x8 always uses TX_4X4, which is also the case the
// spec's ss_size_lookup marks BLOCK_INVALID for chroma.
//
// The plane block is ss_size_lookup[bs][subx][suby], which is the 4x4-unit
// width and height shifted right by the subsampling (at least 1x1). Only
// (subx, suby) = (1, 1), i.e. 4:2:0, is reachable in this decoder: the I420
// frame layout cannot carry 4:2:2 or 4:4:4, and those sizes are rejected
// before prediction. The clamp guards the invalid ss_size_lookup cells that
// a non-4:2:0 caller could reach; for 4:2:0 every shifted dimension is
// already at least 1 because bs >= BLOCK_8X8.
fn recon_uv_tx_size(bs as i64, tx_size as i64, subx as i64, suby as i64) as i64 {
    if (bs < BLOCK_8X8) { return TX_4X4; }
    let is i64 as w with mut = recon_num_4x4_wide(bs) >> subx;
    let is i64 as h with mut = recon_num_4x4_high(bs) >> suby;
    if (w < 1) { w = 1; }
    if (h < 1) { h = 1; }
    let is i64 as plane_bs = recon_block_from_units(w, h);
    let is i64 as max_tx = recon_max_txsize(plane_bs);
    if (tx_size < max_tx) { return tx_size; }
    return max_tx;
}
