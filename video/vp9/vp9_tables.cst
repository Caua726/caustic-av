// =======================================================
// caustic-av/video/vp9/vp9_tables.cst
// Dimensions, fixed lookup tables, probability contexts and the persistent
// decoder state that stages 4-6 share.
//
// The probability values themselves live in vp9_tables_data.cst, a byte
// blob generated by tools/gen_vp9_tables.py from the specification. When
// that file is still pending (VP9_TABLES_GENERATED == 0) the blobs are
// empty; vp9_probctx_default then reports I_UNSUPPORTED and the state marks
// itself pending. Callers may still parse every header field, because the
// arithmetic-coded header consumes the same bits whatever the probability
// values are, but they must not decode tiles until the table is generated.
//
// Layout and ownership:
//   Vp9ProbCtx  the probability tables of one frame context. The four
//               saved contexts plus the working copy live in Vp9State.
//   Vp9Counts   the counters of section 9.3.4, cleared per frame. Stages
//               4-6 increment them; stage 5's adaptation consumes them.
//   Vp9State    everything that survives from one frame to the next:
//               reference geometry and format, the last coded frame, the
//               loop-filter deltas, the segmentation data and the frame
//               contexts. The caller owns the memory and passes a pointer;
//               nothing here allocates or opens a file.
//
// Capacities are fixed by the specification: 8 reference slots, 4 frame
// contexts, 8 segments x 4 features, 4 blocks x 2 x 2 x 6 x 6 x 3
// coefficient probabilities per context. A stream that would exceed any of
// them is corrupt, not something to allocate for.
// =======================================================

use "../../core/errno.cst" as errno;
use "vp9_tables_data.cst" as tbl;

// ── specification constants (section 3) ─────────────────────────────

let is i64 as VP9_REFS_PER_FRAME      with imut = 3;
let is i64 as VP9_REF_FRAMES          with imut = 8;
let is i64 as VP9_MAX_SEGMENTS        with imut = 8;
let is i64 as VP9_SEG_LVL_MAX         with imut = 4;
let is i64 as VP9_SEG_LVL_ALT_Q       with imut = 0;
let is i64 as VP9_SEG_LVL_ALT_L       with imut = 1;
let is i64 as VP9_SEG_LVL_REF_FRAME   with imut = 2;
let is i64 as VP9_SEG_LVL_SKIP        with imut = 3;

let is i64 as VP9_PARTITION_CONTEXTS  with imut = 16;
let is i64 as VP9_PARTITION_TYPES     with imut = 4;
let is i64 as VP9_BLOCK_SIZE_GROUPS   with imut = 4;
let is i64 as VP9_INTRA_MODES         with imut = 10;
let is i64 as VP9_INTER_MODES         with imut = 4;
let is i64 as VP9_INTER_MODE_CONTEXTS with imut = 7;
let is i64 as VP9_SKIP_CONTEXTS       with imut = 3;
let is i64 as VP9_IS_INTER_CONTEXTS   with imut = 4;
let is i64 as VP9_COMP_MODE_CONTEXTS  with imut = 5;
let is i64 as VP9_REF_CONTEXTS        with imut = 5;
let is i64 as VP9_INTERP_FILTER_CONTEXTS with imut = 4;
let is i64 as VP9_SWITCHABLE_FILTERS  with imut = 3;

let is i64 as VP9_TX_SIZES            with imut = 4;
let is i64 as VP9_TX_SIZE_CONTEXTS    with imut = 2;
let is i64 as VP9_TX_MODES            with imut = 5;
let is i64 as VP9_TX_4X4              with imut = 0;
let is i64 as VP9_TX_8X8              with imut = 1;
let is i64 as VP9_TX_16X16            with imut = 2;
let is i64 as VP9_TX_32X32            with imut = 3;
let is i64 as VP9_ONLY_4X4            with imut = 0;
let is i64 as VP9_ALLOW_8X8           with imut = 1;
let is i64 as VP9_ALLOW_16X16         with imut = 2;
let is i64 as VP9_ALLOW_32X32         with imut = 3;
let is i64 as VP9_TX_MODE_SELECT      with imut = 4;

let is i64 as VP9_BLOCK_TYPES         with imut = 2;
let is i64 as VP9_REF_TYPES           with imut = 2;
let is i64 as VP9_COEF_BANDS          with imut = 6;
let is i64 as VP9_PREV_COEF_CONTEXTS  with imut = 6;
let is i64 as VP9_UNCONSTRAINED_NODES with imut = 3;

let is i64 as VP9_MV_JOINTS           with imut = 4;
let is i64 as VP9_MV_CLASSES          with imut = 11;
let is i64 as VP9_CLASS0_SIZE         with imut = 2;
let is i64 as VP9_MV_OFFSET_BITS      with imut = 10;
let is i64 as VP9_MV_FR_SIZE          with imut = 4;

let is i64 as VP9_MAX_TILE_WIDTH_B64  with imut = 64;
let is i64 as VP9_MIN_TILE_WIDTH_B64  with imut = 4;
let is i64 as VP9_MAX_TILE_COLS_LOG2  with imut = 6;
let is i64 as VP9_MAX_TILE_ROWS_LOG2  with imut = 2;
let is i64 as VP9_MAX_TILES           with imut = 256;

// Frame types and reference slots.
let is i64 as VP9_KEY_FRAME            with imut = 0;
let is i64 as VP9_NON_KEY_FRAME        with imut = 1;
let is i64 as VP9_INTRA_FRAME          with imut = 0;
let is i64 as VP9_LAST_FRAME           with imut = 1;
let is i64 as VP9_GOLDEN_FRAME         with imut = 2;
let is i64 as VP9_ALTREF_FRAME         with imut = 3;
let is i64 as VP9_MAX_REF_FRAMES       with imut = 4;

// Interpolation filters and reference modes.
let is i64 as VP9_EIGHTTAP             with imut = 0;
let is i64 as VP9_EIGHTTAP_SMOOTH      with imut = 1;
let is i64 as VP9_EIGHTTAP_SHARP       with imut = 2;
let is i64 as VP9_BILINEAR             with imut = 3;
let is i64 as VP9_SWITCHABLE           with imut = 4;
let is i64 as VP9_SINGLE_REFERENCE     with imut = 0;
let is i64 as VP9_COMPOUND_REFERENCE   with imut = 1;
let is i64 as VP9_REFERENCE_MODE_SELECT with imut = 2;

// Frame-sync bytes (section 7.2.1).
let is i64 as VP9_SYNC_0                with imut = 0x49;
let is i64 as VP9_SYNC_1                with imut = 0x83;
let is i64 as VP9_SYNC_2                with imut = 0x42;

// Probability-context element counts.
let is i64 as VP9_COEF_CTX_LEN         with imut = 1728;   // 4*2*2*6*6*3
let is i64 as VP9_DEFAULT_PROBS_LEN    with imut = 2051;
let is i64 as VP9_KF_PROBS_LEN         with imut = 1038;
let is i64 as VP9_INV_MAP_LEN          with imut = 255;

// ── fixed lookup tables read from the specification ────────────────

// literal_to_type[4] (section 6.2.7).
fn vp9_literal_to_type(raw as i64) as i64 {
    if (raw == 0) { return VP9_EIGHTTAP_SMOOTH; }
    if (raw == 1) { return VP9_EIGHTTAP; }
    if (raw == 2) { return VP9_EIGHTTAP_SHARP; }
    return VP9_BILINEAR;
}

// segmentation_feature_bits[SEG_LVL_MAX] (section 6.2.11).
fn vp9_segmentation_feature_bits(j as i64) as i64 {
    if (j == 0) { return 8; }
    if (j == 1) { return 6; }
    if (j == 2) { return 2; }
    return 0;
}

// segmentation_feature_signed[SEG_LVL_MAX] (section 6.2.11).
fn vp9_segmentation_feature_signed(j as i64) as i64 {
    if (j == 0 || j == 1) { return 1; }
    return 0;
}

// tx_mode_to_biggest_tx_size[TX_MODES] (section 10.2).
fn vp9_tx_mode_to_biggest_tx_size(mode as i64) as i64 {
    if (mode < 0 || mode >= VP9_TX_MODES) { return errno.I_BADPARAM; }
    if (mode <= VP9_TX_32X32) { return mode; }
    return VP9_TX_32X32;
}

// A byte is a superframe marker when its top three bits are 0b110
// (section B.4).
fn vp9_is_superframe_marker(b as i64) as i64 {
    if (b < 0 || b > 255) { return 0; }
    if ((b & 0xE0) == 0xC0) { return 1; }
    return 0;
}

// ── generated-table access ──────────────────────────────────────────

// 1 once tools/gen_vp9_tables.py has written the blobs.
fn vp9_tables_ready() as i64 {
    return tbl.VP9_TABLES_GENERATED;
}

fn _blob_byte(base as *u8, off as i64) as i64 {
    return cast(i64, base[off]);
}

// inv_map_table[v] for a deltaProb v (section 6.3.5).
fn vp9_inv_map(v as i64) as i64 {
    if (tbl.VP9_TABLES_GENERATED == 0) { return errno.I_UNSUPPORTED; }
    if (v < 0 || v >= VP9_INV_MAP_LEN) { return errno.I_CORRUPT; }
    return _blob_byte(tbl.VP9_TBL_INV_MAP, v);
}

// inv_recenter_nonneg (section 6.3.6).
fn _inv_recenter_nonneg(v as i64, m as i64) as i64 {
    if (v > 2 * m) { return v; }
    if ((v & 1) == 1) { return m - ((v + 1) >> 1); }
    return m + (v >> 1);
}

// inv_remap_prob (section 6.3.5). The result is a probability 1..255.
fn vp9_inv_remap_prob(delta as i64, prob as i64) as i64 {
    if (tbl.VP9_TABLES_GENERATED == 0) { return errno.I_UNSUPPORTED; }
    if (delta < 0 || delta >= 255) { return errno.I_CORRUPT; }
    if (prob < 1 || prob > 255) { return errno.I_CORRUPT; }

    let is i64 as v = vp9_inv_map(delta);
    if (v < 0) { return v; }
    let is i64 as m = prob - 1;
    let is i64 as out with mut = 0;
    if ((m << 1) <= 255) { out = 1 + _inv_recenter_nonneg(v, m); }
    else { out = 255 - _inv_recenter_nonneg(v, 255 - 1 - m); }
    if (out < 1 || out > 255) { return errno.I_CORRUPT; }
    return out;
}

// kf_partition_probs[ctx][node] (section 10.4).
fn vp9_kf_partition_prob(ctx as i64, node as i64) as i64 {
    if (tbl.VP9_TABLES_GENERATED == 0) { return errno.I_UNSUPPORTED; }
    if (ctx < 0 || ctx >= VP9_PARTITION_CONTEXTS) { return errno.I_BADPARAM; }
    if (node < 0 || node >= VP9_PARTITION_TYPES - 1) {
        return errno.I_BADPARAM;
    }
    return _blob_byte(tbl.VP9_TBL_KF_PROBS, ctx * 3 + node);
}

// kf_y_mode_probs[above][left][node] (section 10.4).
fn vp9_kf_y_mode_prob(above as i64, left as i64, node as i64) as i64 {
    if (tbl.VP9_TABLES_GENERATED == 0) { return errno.I_UNSUPPORTED; }
    if (above < 0 || above >= VP9_INTRA_MODES) { return errno.I_BADPARAM; }
    if (left < 0 || left >= VP9_INTRA_MODES) { return errno.I_BADPARAM; }
    if (node < 0 || node >= VP9_INTRA_MODES - 1) { return errno.I_BADPARAM; }
    let is i64 as off = 48 + ((above * VP9_INTRA_MODES) + left)
                        * (VP9_INTRA_MODES - 1) + node;
    return _blob_byte(tbl.VP9_TBL_KF_PROBS, off);
}

// kf_uv_mode_probs[y_mode][node] (section 10.4).
fn vp9_kf_uv_mode_prob(y_mode as i64, node as i64) as i64 {
    if (tbl.VP9_TABLES_GENERATED == 0) { return errno.I_UNSUPPORTED; }
    if (y_mode < 0 || y_mode >= VP9_INTRA_MODES) { return errno.I_BADPARAM; }
    if (node < 0 || node >= VP9_INTRA_MODES - 1) { return errno.I_BADPARAM; }
    let is i64 as off = 48 + 900 + y_mode * (VP9_INTRA_MODES - 1) + node;
    return _blob_byte(tbl.VP9_TBL_KF_PROBS, off);
}

// ── probability contexts ────────────────────────────────────────────

// Every adaptive probability table of one frame context. The fixed
// keyframe tables (kf_partition/kf_y_mode/kf_uv_mode) are not here: they
// are never updated and are read through the accessors above.
struct Vp9ProbCtx {
    partition     as [16][3]u8;     // partition_probs
    y_mode        as [4][9]u8;      // y_mode_probs
    uv_mode       as [10][9]u8;     // uv_mode_probs
    skip          as [3]u8;         // skip_prob
    is_inter      as [4]u8;         // is_inter_prob
    comp_mode     as [5]u8;         // comp_mode_prob
    comp_ref      as [5]u8;         // comp_ref_prob
    single_ref    as [5][2]u8;      // single_ref_prob
    inter_mode    as [7][3]u8;      // inter_mode_probs
    interp_filter as [4][2]u8;      // interp_filter_probs
    tx            as [4][2][3]u8;    // tx_probs[txSz][ctx][node]
    mv_joint      as [3]u8;
    mv_sign       as [2]u8;
    mv_class      as [2][10]u8;
    mv_class0_bit as [2]u8;
    mv_bits       as [2][10]u8;
    mv_class0_fr  as [2][2][3]u8;
    mv_class0_hp  as [2]u8;
    mv_fr         as [2][3]u8;
    mv_hp         as [2]u8;
    coef          as [4][2][2][6][6][3]u8;
}

// The counters of section 9.3.4. Counts are plain integers; stage 5's
// adaptation reads them and the next frame clears them.
struct Vp9Counts {
    partition     as [16][4]i64;
    y_mode        as [4][10]i64;
    uv_mode       as [10][10]i64;
    skip          as [3][2]i64;
    is_inter      as [4][2]i64;
    comp_mode     as [5][2]i64;
    comp_ref      as [5][2]i64;
    single_ref    as [5][2][2]i64;
    inter_mode    as [7][4]i64;
    interp_filter as [4][3]i64;
    tx            as [4][2][4]i64;
    mv_joint      as [4]i64;
    mv_sign       as [2][2]i64;
    mv_class      as [2][11]i64;
    mv_class0_bit as [2][2]i64;
    mv_bits       as [2][10][2]i64;
    mv_class0_fr  as [2][2][4]i64;
    mv_class0_hp  as [2][2]i64;
    mv_fr         as [2][4]i64;
    mv_hp         as [2][2]i64;
    token         as [4][2][2][6][6][3]i64;
    more_coefs    as [4][2][2][6][6][2]i64;
}

fn _bytes_zero(p as *u8, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { p[i] = cast(u8, 0); i = i + 1; }
}

fn _bytes_copy(d as *u8, s as *u8, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = s[i]; i = i + 1; }
}

fn vp9_probctx_zero(p as *Vp9ProbCtx) as void {
    if (cast(i64, p) == 0) { return; }
    _bytes_zero(cast(*u8, p), sizeof(Vp9ProbCtx));
}

fn vp9_probctx_copy(d as *Vp9ProbCtx, s as *Vp9ProbCtx) as void {
    if (cast(i64, d) == 0 || cast(i64, s) == 0) { return; }
    _bytes_copy(cast(*u8, d), cast(*u8, s), sizeof(Vp9ProbCtx));
}

fn vp9_counts_clear(c as *Vp9Counts) as void {
    if (cast(i64, c) == 0) { return; }
    _bytes_zero(cast(*u8, c), sizeof(Vp9Counts));
}

// Load the default probability tables (section 10.5) into one context.
// Returns I_UNSUPPORTED while vp9_tables_data.cst is pending, in which case
// the context is not usable for tile decoding.
fn vp9_probctx_default(p as *Vp9ProbCtx) as i64 {
    if (cast(i64, p) == 0) { return errno.I_BADPARAM; }
    if (tbl.VP9_TABLES_GENERATED == 0) { return errno.I_UNSUPPORTED; }
    let is *u8 as base = tbl.VP9_TBL_DEFAULT_PROBS;
    let is i64 as o with mut = 0;
    let is i64 as i with mut = 0;
    let is i64 as j with mut = 0;
    let is i64 as k with mut = 0;

    i = 0;
    while (i < 16) {
        j = 0;
        while (j < 3) { p.partition[i][j] = base[o]; o = o + 1; j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < 4) {
        j = 0;
        while (j < 9) { p.y_mode[i][j] = base[o]; o = o + 1; j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < 10) {
        j = 0;
        while (j < 9) { p.uv_mode[i][j] = base[o]; o = o + 1; j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < 3) { p.skip[i] = base[o]; o = o + 1; i = i + 1; }
    i = 0;
    while (i < 4) { p.is_inter[i] = base[o]; o = o + 1; i = i + 1; }
    i = 0;
    while (i < 5) { p.comp_mode[i] = base[o]; o = o + 1; i = i + 1; }
    i = 0;
    while (i < 5) { p.comp_ref[i] = base[o]; o = o + 1; i = i + 1; }
    i = 0;
    while (i < 5) {
        j = 0;
        while (j < 2) {
            p.single_ref[i][j] = base[o]; o = o + 1; j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < 2) { p.mv_sign[i] = base[o]; o = o + 1; i = i + 1; }
    i = 0;
    while (i < 2) {
        j = 0;
        while (j < 10) { p.mv_bits[i][j] = base[o]; o = o + 1; j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < 2) { p.mv_class0_bit[i] = base[o]; o = o + 1; i = i + 1; }
    i = 0;
    while (i < 4) {
        j = 0;
        while (j < 2) {
            k = 0;
            while (k < 3) {
                p.tx[i][j][k] = base[o]; o = o + 1; k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < 7) {
        j = 0;
        while (j < 3) { p.inter_mode[i][j] = base[o]; o = o + 1; j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < 4) {
        j = 0;
        while (j < 2) {
            p.interp_filter[i][j] = base[o]; o = o + 1; j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < 3) { p.mv_joint[i] = base[o]; o = o + 1; i = i + 1; }
    i = 0;
    while (i < 2) {
        j = 0;
        while (j < 10) { p.mv_class[i][j] = base[o]; o = o + 1; j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < 2) {
        j = 0;
        while (j < 2) {
            k = 0;
            while (k < 3) {
                p.mv_class0_fr[i][j][k] = base[o]; o = o + 1; k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < 2) { p.mv_class0_hp[i] = base[o]; o = o + 1; i = i + 1; }
    i = 0;
    while (i < 2) {
        j = 0;
        while (j < 3) { p.mv_fr[i][j] = base[o]; o = o + 1; j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < 2) { p.mv_hp[i] = base[o]; o = o + 1; i = i + 1; }
    i = 0;
    while (i < 4) {
        j = 0;
        while (j < 2) {
            k = 0;
            while (k < 2) {
                let is i64 as band with mut = 0;
                while (band < 6) {
                    let is i64 as ctx with mut = 0;
                    while (ctx < 6) {
                        let is i64 as node with mut = 0;
                        while (node < 3) {
                            p.coef[i][j][k][band][ctx][node] = base[o];
                            o = o + 1;
                            node = node + 1;
                        }
                        ctx = ctx + 1;
                    }
                    band = band + 1;
                }
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return errno.I_OK;
}

// ── persistent decoder state ────────────────────────────────────────

// Everything that survives between coded frames. The caller allocates it,
// zeroes it once with vp9_state_init, and passes the same pointer for every
// frame of the stream. Stage 4 calls vp9_state_publish once a frame has
// been fully reconstructed and its slot data is valid.
struct Vp9State {
    probs         as Vp9ProbCtx;   // working tables for the current frame
    ctxs          as [4]Vp9ProbCtx;
    ctx_init      as [4]i64;       // 1 once save_probs has filled a context
    counts        as Vp9Counts;
    probs_pending as i64;          // 1 while the default blobs are missing

    // Format of the last coded frame. Only a key frame or an intra-only
    // frame codes it; inter frames inherit it, and section 7.2 requires the
    // selected references to match.
    cur_bit_depth    as i64;
    cur_color_space  as i64;
    cur_color_range  as i64;
    cur_subsampling_x as i64;
    cur_subsampling_y as i64;

    // Reference slots, filled by vp9_state_publish.
    ref_width     as [8]i64;
    ref_height    as [8]i64;
    ref_valid     as [8]i64;
    ref_profile   as [8]i64;
    ref_bit_depth as [8]i64;
    ref_ss_x      as [8]i64;
    ref_ss_y      as [8]i64;
    ref_color_space as [8]i64;

    // Previous coded frame, used by compute_image_size and by adaptation.
    have_last_frame   as i64;
    last_frame_type   as i64;
    last_intra_only   as i64;
    last_show_frame   as i64;
    last_width        as i64;
    last_height       as i64;

    // Values that section 7.2.8 says persist until setup_past_independence.
    lf_ref_delta  as [4]i64;
    lf_mode_delta as [2]i64;

    // Segmentation data persists across frames between explicit updates.
    // setup_past_independence clears the features but not the tree
    // probabilities, which are only replaced when update_map is coded.
    seg_tree_prob        as [7]u8;
    seg_pred_prob        as [3]u8;
    seg_feature_enabled  as [8][4]i64;
    seg_feature_data     as [8][4]i64;
    seg_abs_or_delta     as i64;
}

fn _state_lf_defaults(st as *Vp9State) as void {
    st.lf_ref_delta[0] = 1;      // INTRA_FRAME
    st.lf_ref_delta[1] = 0;      // LAST_FRAME
    st.lf_ref_delta[2] = 0 - 1;  // GOLDEN_FRAME
    st.lf_ref_delta[3] = 0 - 1;  // ALTREF_FRAME
    st.lf_mode_delta[0] = 0;
    st.lf_mode_delta[1] = 0;
}

// Zero the whole state and install the initial loop-filter deltas. No frame
// context is valid yet: an inter frame that arrives before a key or
// intra-only frame is corrupt (libvpx calls this "uninitialized entropy
// context").
fn vp9_state_init(st as *Vp9State) as void {
    if (cast(i64, st) == 0) { return; }
    _bytes_zero(cast(*u8, st), sizeof(Vp9State));
    _state_lf_defaults(st);
    if (tbl.VP9_TABLES_GENERATED == 0) { st.probs_pending = 1; }
    else { st.probs_pending = 0; }
}

// The structural half of setup_past_independence (section 7.2). The caller
// zeroes the frame's ref_frame_sign_bias after calling this, as the syntax
// does. The probability tables are reset when the generated blobs exist;
// otherwise the working context is zeroed and marked pending, which keeps
// header parsing possible but makes tile decoding refuse to run.
fn vp9_state_setup_past_independence(st as *Vp9State) as void {
    if (cast(i64, st) == 0) { return; }
    let is i64 as i with mut = 0;
    let is i64 as j with mut = 0;
    while (i < 8) {
        j = 0;
        while (j < 4) {
            st.seg_feature_enabled[i][j] = 0;
            st.seg_feature_data[i][j] = 0;
            j = j + 1;
        }
        i = i + 1;
    }
    _state_lf_defaults(st);
    st.seg_abs_or_delta = 0;

    let is i64 as r = vp9_probctx_default(&st.probs);
    if (r < 0) {
        vp9_probctx_zero(&st.probs);
        st.probs_pending = 1;
    } else {
        st.probs_pending = 0;
    }
}

// load_probs(ctx): every adaptive table except tx_probs and skip_prob.
fn vp9_state_load_probs(st as *Vp9State, idx as i64) as i64 {
    if (cast(i64, st) == 0) { return errno.I_BADPARAM; }
    if (idx < 0 || idx >= 4) { return errno.I_BADPARAM; }
    if (st.ctx_init[idx] == 0) { return errno.I_CORRUPT; }

    let is [4][2][3]u8 as keep_tx;
    let is [3]u8 as keep_skip;
    let is i64 as i with mut = 0;
    let is i64 as j with mut = 0;
    let is i64 as k with mut = 0;
    while (i < 4) {
        j = 0;
        while (j < 2) {
            k = 0;
            while (k < 3) {
                keep_tx[i][j][k] = st.probs.tx[i][j][k];
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < 3) { keep_skip[i] = st.probs.skip[i]; i = i + 1; }

    vp9_probctx_copy(&st.probs, &st.ctxs[idx]);

    i = 0;
    while (i < 4) {
        j = 0;
        while (j < 2) {
            k = 0;
            while (k < 3) {
                st.probs.tx[i][j][k] = keep_tx[i][j][k];
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < 3) { st.probs.skip[i] = keep_skip[i]; i = i + 1; }
    return errno.I_OK;
}

// load_probs2(ctx): tx_probs and skip_prob only.
fn vp9_state_load_probs2(st as *Vp9State, idx as i64) as i64 {
    if (cast(i64, st) == 0) { return errno.I_BADPARAM; }
    if (idx < 0 || idx >= 4) { return errno.I_BADPARAM; }
    if (st.ctx_init[idx] == 0) { return errno.I_CORRUPT; }

    let is i64 as i with mut = 0;
    let is i64 as j with mut = 0;
    let is i64 as k with mut = 0;
    while (i < 4) {
        j = 0;
        while (j < 2) {
            k = 0;
            while (k < 3) {
                st.probs.tx[i][j][k] = st.ctxs[idx].tx[i][j][k];
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < 3) { st.probs.skip[i] = st.ctxs[idx].skip[i]; i = i + 1; }
    return errno.I_OK;
}

// save_probs(ctx): save every table, including tx_probs and skip_prob.
fn vp9_state_save_probs(st as *Vp9State, idx as i64) as i64 {
    if (cast(i64, st) == 0) { return errno.I_BADPARAM; }
    if (idx < 0 || idx >= 4) { return errno.I_BADPARAM; }
    vp9_probctx_copy(&st.ctxs[idx], &st.probs);
    st.ctx_init[idx] = 1;
    return errno.I_OK;
}

fn vp9_state_clear_counts(st as *Vp9State) as void {
    if (cast(i64, st) == 0) { return; }
    vp9_counts_clear(&st.counts);
}

// Publish a decoded frame into the reference slots selected by
// refresh_frame_flags. The header parser does not call this: only a frame
// that has been reconstructed may be referenced, so stage 4 calls it after
// the tiles succeed. The format is recorded because section 7.2 requires
// every selected reference to match the current frame's profile, bit depth,
// chroma subsampling and color space.
fn vp9_state_publish(st as *Vp9State, refresh_flags as i64,
                     width as i64, height as i64, profile as i64,
                     bit_depth as i64, ss_x as i64, ss_y as i64,
                     color_space as i64) as void {
    if (cast(i64, st) == 0) { return; }
    let is i64 as i with mut = 0;
    while (i < 8) {
        if (((refresh_flags >> i) & 1) == 1) {
            st.ref_width[i] = width;
            st.ref_height[i] = height;
            st.ref_valid[i] = 1;
            st.ref_profile[i] = profile;
            st.ref_bit_depth[i] = bit_depth;
            st.ref_ss_x[i] = ss_x;
            st.ref_ss_y[i] = ss_y;
            st.ref_color_space[i] = color_space;
        }
        i = i + 1;
    }
}
