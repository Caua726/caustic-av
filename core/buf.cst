// =======================================================
// caustic-av/core/buf.cst
// Offset-driven byte cursor over caller-owned memory. Containers and codecs
// read through this instead of indexing raw pointers, so every access is
// bounds-checked. A read that would pass the end returns I_EOF and leaves the
// cursor where it was; a truncated file therefore cannot move a parser
// forward or index outside its buffer. There is no allocation here.
//
// Multi-byte helpers exist for both endiannesses and for 8, 16, 24, 32 and
// 64 bits. The u64 helpers return the raw 64 bits as an i64: a value with bit
// 63 set comes back negative, and casting it to u64 recovers the value. That
// is the one place where a negative result is data rather than an error.
// =======================================================

use "errno.cst" as errno;

struct Buf {
    ptr as *u8;
    len as i64;
    pos as i64;
}

// Start a cursor at offset 0. A negative length is treated as empty.
fn buf_init(b as *Buf, ptr as *u8, len as i64) as void {
    b.ptr = ptr;
    b.len = len;
    if (len < 0) { b.len = 0; }
    b.pos = 0;
}

fn buf_pos(b as *Buf) as i64 {
    return b.pos;
}

fn buf_remaining(b as *Buf) as i64 {
    return b.len - b.pos;
}

fn buf_eof(b as *Buf) as i64 {
    if (b.pos >= b.len) { return 1; }
    return 0;
}

// Absolute seek. Reaching the end (pos == len) is allowed; anything outside
// 0..len returns I_EOF and leaves the cursor untouched.
fn buf_seek(b as *Buf, off as i64) as i64 {
    if (off < 0) { return errno.I_EOF; }
    if (off > b.len) { return errno.I_EOF; }
    b.pos = off;
    return errno.I_OK;
}

// Skip n bytes forward. A negative count is I_BADPARAM; too few bytes is
// I_EOF. Neither moves the cursor.
fn buf_skip(b as *Buf, n as i64) as i64 {
    if (n < 0) { return errno.I_BADPARAM; }
    if (buf_remaining(b) < n) { return errno.I_EOF; }
    b.pos = b.pos + n;
    return errno.I_OK;
}

// Byte at off bytes ahead of the cursor, without consuming. Negative offsets
// are rejected rather than reading before the start.
fn buf_peek(b as *Buf, off as i64) as i64 {
    if (off < 0) { return errno.I_EOF; }
    let is i64 as i = b.pos + off;
    if (i >= b.len) { return errno.I_EOF; }
    return cast(i64, b.ptr[i]);
}

// Byte at absolute offset off, without consuming. The offset is from the
// start of the buffer, not from the cursor.
fn buf_at(b as *Buf, off as i64) as i64 {
    if (off < 0) { return errno.I_EOF; }
    if (off >= b.len) { return errno.I_EOF; }
    return cast(i64, b.ptr[off]);
}

// Next byte as 0..255, or I_EOF. A valid byte is never negative.
fn buf_u8(b as *Buf) as i64 {
    if (b.pos >= b.len) { return errno.I_EOF; }
    let is i64 as v = cast(i64, b.ptr[b.pos]);
    b.pos = b.pos + 1;
    return v;
}

fn buf_u16le(b as *Buf) as i64 {
    if (buf_remaining(b) < 2) { return errno.I_EOF; }
    let is i64 as v = cast(i64, b.ptr[b.pos])
        | (cast(i64, b.ptr[b.pos + 1]) << 8);
    b.pos = b.pos + 2;
    return v;
}

fn buf_u16be(b as *Buf) as i64 {
    if (buf_remaining(b) < 2) { return errno.I_EOF; }
    let is i64 as v = (cast(i64, b.ptr[b.pos]) << 8)
        | cast(i64, b.ptr[b.pos + 1]);
    b.pos = b.pos + 2;
    return v;
}

fn buf_u24le(b as *Buf) as i64 {
    if (buf_remaining(b) < 3) { return errno.I_EOF; }
    let is i64 as v = cast(i64, b.ptr[b.pos])
        | (cast(i64, b.ptr[b.pos + 1]) << 8)
        | (cast(i64, b.ptr[b.pos + 2]) << 16);
    b.pos = b.pos + 3;
    return v;
}

fn buf_u24be(b as *Buf) as i64 {
    if (buf_remaining(b) < 3) { return errno.I_EOF; }
    let is i64 as v = (cast(i64, b.ptr[b.pos]) << 16)
        | (cast(i64, b.ptr[b.pos + 1]) << 8)
        | cast(i64, b.ptr[b.pos + 2]);
    b.pos = b.pos + 3;
    return v;
}

fn buf_u32le(b as *Buf) as i64 {
    if (buf_remaining(b) < 4) { return errno.I_EOF; }
    let is i64 as v = cast(i64, b.ptr[b.pos])
        | (cast(i64, b.ptr[b.pos + 1]) << 8)
        | (cast(i64, b.ptr[b.pos + 2]) << 16)
        | (cast(i64, b.ptr[b.pos + 3]) << 24);
    b.pos = b.pos + 4;
    return v;
}

fn buf_u32be(b as *Buf) as i64 {
    if (buf_remaining(b) < 4) { return errno.I_EOF; }
    let is i64 as v = (cast(i64, b.ptr[b.pos]) << 24)
        | (cast(i64, b.ptr[b.pos + 1]) << 16)
        | (cast(i64, b.ptr[b.pos + 2]) << 8)
        | cast(i64, b.ptr[b.pos + 3]);
    b.pos = b.pos + 4;
    return v;
}

// Raw 64-bit little-endian value. See the file header: bit 63 set makes the
// i64 negative, and that is data.
fn buf_u64le(b as *Buf) as i64 {
    if (buf_remaining(b) < 8) { return errno.I_EOF; }
    let is i64 as lo = cast(i64, b.ptr[b.pos])
        | (cast(i64, b.ptr[b.pos + 1]) << 8)
        | (cast(i64, b.ptr[b.pos + 2]) << 16)
        | (cast(i64, b.ptr[b.pos + 3]) << 24);
    let is i64 as hi = cast(i64, b.ptr[b.pos + 4])
        | (cast(i64, b.ptr[b.pos + 5]) << 8)
        | (cast(i64, b.ptr[b.pos + 6]) << 16)
        | (cast(i64, b.ptr[b.pos + 7]) << 24);
    b.pos = b.pos + 8;
    return lo | (hi << 32);
}

// Raw 64-bit big-endian value, with the same caveat about bit 63.
fn buf_u64be(b as *Buf) as i64 {
    if (buf_remaining(b) < 8) { return errno.I_EOF; }
    let is i64 as hi = (cast(i64, b.ptr[b.pos]) << 24)
        | (cast(i64, b.ptr[b.pos + 1]) << 16)
        | (cast(i64, b.ptr[b.pos + 2]) << 8)
        | cast(i64, b.ptr[b.pos + 3]);
    let is i64 as lo = (cast(i64, b.ptr[b.pos + 4]) << 24)
        | (cast(i64, b.ptr[b.pos + 5]) << 16)
        | (cast(i64, b.ptr[b.pos + 6]) << 8)
        | cast(i64, b.ptr[b.pos + 7]);
    b.pos = b.pos + 8;
    return (hi << 32) | lo;
}

// Copy n bytes to dst. A negative count is I_BADPARAM; too few bytes is
// I_EOF. Neither moves the cursor and neither writes to dst.
fn buf_read(b as *Buf, dst as *u8, n as i64) as i64 {
    if (n < 0) { return errno.I_BADPARAM; }
    if (buf_remaining(b) < n) { return errno.I_EOF; }
    let is i64 as i with mut = 0;
    while (i < n) {
        dst[i] = b.ptr[b.pos + i];
        i = i + 1;
    }
    b.pos = b.pos + n;
    return errno.I_OK;
}

// Raw pointer to the cursor position (zero-copy handoff to a codec).
fn buf_here(b as *Buf) as *u8 {
    return cast(*u8, cast(i64, b.ptr) + b.pos);
}
