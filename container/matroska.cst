// =======================================================
// caustic-av/container/matroska.cst
// Demuxer for Matroska and its restricted WebM profile. It reads the EBML
// header, the Segment, Info, Tracks and the cluster stream, and hands out one
// packet per Matroska frame. All bytes are borrowed from the caller's source;
// the demuxer allocates nothing and opens no files.
//
// The layout it expects is the one the specification defines:
//
//   EBML header: DocType must be "webm" or "matroska", and
//                DocTypeReadVersion must be <= 4 (the elements read here
//                exist in that version).
//   Segment:     may have an unknown size (the file length ends it).
//   Info:        TimecodeScale (default 1,000,000 ns) and Duration. An
//                absent Duration stays 0.0; a present one must be finite and
//                greater than zero, the range RFC 9559 Section 5.1.2.10
//                gives, so a present zero is refused rather than reported
//                as "absent".
//   Tracks:      up to MK_MAX_TRACKS entries, fixed at compile time. A count
//                past the array is corrupt, not something to allocate for.
//   Cluster:     Timestamp (mandatory, RFC 9559 Section 5.1.3.1; a Block
//                that arrives before it is I_CORRUPT) plus SimpleBlock and
//                BlockGroup/Block. A cluster may have an unknown size too;
//                then it ends at the next Cluster or at the end of the
//                Segment.
//
// Timestamps: a block's raw timestamp is
//   (cluster Timecode + block relative timestamp) * TimecodeScale
// and every value this module reports in pts/dts/duration is in nanoseconds.
// CodecDelay and SeekPreRoll are reported on the track in nanoseconds; the
// demuxer does not subtract them, because they describe the decoder's
// pre-roll rather than the container timeline. (FFmpeg's matroskadec.c
// subtracts CodecDelay from pts after rounding it to the track's millisecond
// timebase; that is an AVPacket policy, not the Block timeline. Here the
// caller sees the container value plus the delay field, and the decoder can
// apply the pre-roll once, at the right precision.)
//
// TrackTimestampScale (0x23314F) would multiply every timestamp of one track;
// this stage's timing contract is Info TimecodeScale alone, so a value other
// than 1.0 is refused with I_UNSUPPORTED rather than silently ignored.
//
// Lacing: SimpleBlock and Block may pack several frames into one payload.
// All three modes are decoded (Xiph, fixed-size and EBML) and one packet is
// returned per lace, in order, with the frame slice, its own pts and its
// duration. A BlockDuration, or DefaultDuration * lace count when the block
// has none, is spread over the laces with the same integer split FFmpeg uses:
// lace i gets total*(i+1)/count - total*i/count nanoseconds, so a remainder is
// spread one nanosecond at a time instead of landing entirely on the last
// frame.
//
// A lace size is a VINT but not an Element Data Size: RFC 8794 Section 6.2
// reserves all-ones VINT_DATA as "unknown" only for Element Data Size, so in
// the lacing header 0xFF is the value 127 for a first frame size and +64 for
// a one-byte signed difference (127 minus the 1-byte bias 63). The block's
// TrackNumber is a VINT of the same kind: all-ones data bits are a number,
// not a sentinel.
//
// Tracks: a TrackEntry must carry a nonzero TrackNumber, a nonzero TrackType
// and a non-empty CodecID; an entry missing any of them is I_CORRUPT rather
// than a track whose type or codec is guessed. TrackUID is not required; it
// identifies a track for stream copy, not for block routing here.
//
// Audio: when the Audio master is present, a missing (or zero-octet)
// SamplingFrequency means its 8000 Hz default and a missing Channels means
// 1. A frequency that is non-finite or not greater than zero, or a channel
// count of zero, is outside the specification's range and is I_CORRUPT
// instead of being clamped to a number the file did not state. A track with
// no Audio master keeps 0.0/0, which is how video tracks report "no audio".
//
// DiscardPadding is positive for padding at the end of a Block and negative
// for padding at its beginning (RFC 9559 Section 5.1.3.5.7). The Packet field
// this module fills describes end padding only, so a negative value is
// I_UNSUPPORTED: reporting its magnitude as end padding, or dropping it,
// would change packet semantics silently.
//
// Limits and deliberate leniency:
//
//   Metadata after the first Cluster. RFC 9559 Section 6.1 requires the
//   first Info and Tracks to be stored before the first Cluster, or to be
//   referenced by a SeekHead before it. The segment walk stops at the first
//   Cluster and SeekHead is not parsed, so a file that keeps Info or Tracks
//   only after that Cluster, and needs its SeekHead followed to reach them,
//   is unsupported. It ends the walk with no tracks and is reported
//   I_CORRUPT: without SeekHead there is no honest way to distinguish
//   "metadata later" from "no metadata", so I_UNSUPPORTED cannot be produced
//   there today.
//
//   Unknown-size Cluster ends. Only a Cluster ID ends one. Every other
//   supported element is skipped by its validated size, so treating a
//   Segment-level sibling (Cues, Tags, Chapters, Attachments, SeekHead,
//   Void, CRC-32) as a skipped cluster child has the same net effect as
//   ending the cluster: it yields no packets, and the next Cluster is still
//   found at its own header. Only Cluster and Segment may be unknown-size
//   (RFC 8794 Section 6.2); any other unknown-size child is I_CORRUPT.
//
//   EBML header bounds are checked, not enforced. A stored
//   EBMLMaxIDLength that is zero or above 4, or EBMLMaxSizeLength that is
//   zero or above 8, is I_UNSUPPORTED, but a narrower declaration does not
//   restrict ebml.cst, whose IDs are fixed at four bytes and sizes at eight.
//   Enforcing the narrower bound would mean passing it into Ebml, an
//   interface this stage keeps fixed; the declared values are therefore
//   validated and reported but not applied to every vint.
//
//   Empty Elements. RFC 8794 Section 6.1 requires an Empty Element with a
//   declared default to be read as that default: EBMLReadVersion 1,
//   EBMLMaxIDLength 4, EBMLMaxSizeLength 8, DocTypeReadVersion 1,
//   TimestampScale 1,000,000, TrackTimestampScale 1.0, SamplingFrequency
//   8000 and Channels 1 all leave their default in place when the payload is
//   zero octets. A stored zero is a real value and is range-checked as one,
//   so it is still refused wherever the element's range excludes it.
//
//   Block leniency. The reserved bits of SimpleBlock/Block are accepted
//   nonzero, Invisible and Discardable are ignored (Packet has no field for
//   them), and lacing is decoded even when the track's FlagLacing is 0. The
//   bits that are consumed are masked; the rest is left to the encoder.
//   The lace table itself is strict: a size that does not fit the block is
//   I_CORRUPT before any packet is published.
//
//   Track capacity. MK_MAX_TRACKS is fixed at 64 and Tracks is an array
//   inside Mk, so a file with more entries is I_CORRUPT rather than an
//   allocation. Growing it would change the caller-visible layout; some
//   future interface may instead accept a caller-supplied array and report
//   I_UNSUPPORTED when the file exceeds it.
//
// Packet data points into src and stays valid until the next mk_next call,
// like every borrowed view in this library.
// =======================================================

use "ebml.cst" as ebml;
use "../core/errno.cst" as errno;
use "../core/packet.cst" as packet;

// ── EBML header and top-level element IDs ───────────────────────────

let is i64 as EBML_HEADER        with imut = 440786851;   // 0x1A45DFA3
let is i64 as EBML_DOC_TYPE      with imut = 17026;       // 0x4282
let is i64 as EBML_DOC_TYPE_READ with imut = 17029;       // 0x4285
let is i64 as EBML_READ_VERSION  with imut = 17143;       // 0x42F7
let is i64 as EBML_MAX_ID_LENGTH with imut = 17138;       // 0x42F2
let is i64 as EBML_MAX_SIZE_LENGTH with imut = 17139;     // 0x42F3

let is i64 as MK_SEGMENT         with imut = 408125543;   // 0x18538067
let is i64 as MK_INFO            with imut = 357149030;   // 0x1549A966
let is i64 as MK_TRACKS          with imut = 374648427;   // 0x1654AE6B

// ── Info ────────────────────────────────────────────────────────────

let is i64 as MK_TIMECODE_SCALE  with imut = 2807729;     // 0x2AD7B1
let is i64 as MK_DURATION        with imut = 17545;       // 0x4489

// ── Tracks ──────────────────────────────────────────────────────────

let is i64 as MK_TRACK_ENTRY         with imut = 174;     // 0xAE
let is i64 as MK_TRACK_NUMBER        with imut = 215;     // 0xD7
let is i64 as MK_TRACK_TYPE          with imut = 131;     // 0x83
let is i64 as MK_CODEC_ID            with imut = 134;     // 0x86
let is i64 as MK_CODEC_PRIVATE       with imut = 25506;   // 0x63A2
let is i64 as MK_DEFAULT_DURATION    with imut = 2352003; // 0x23E383
let is i64 as MK_TRACK_TIMESTAMP_SCALE with imut = 2306383; // 0x23314F
let is i64 as MK_CODEC_DELAY         with imut = 22186;   // 0x56AA
let is i64 as MK_SEEK_PRE_ROLL       with imut = 22203;   // 0x56BB
let is i64 as MK_VIDEO               with imut = 224;     // 0xE0
let is i64 as MK_PIXEL_WIDTH         with imut = 176;     // 0xB0
let is i64 as MK_PIXEL_HEIGHT        with imut = 186;     // 0xBA
let is i64 as MK_AUDIO               with imut = 225;     // 0xE1
let is i64 as MK_SAMPLING_FREQUENCY  with imut = 181;     // 0xB5
let is i64 as MK_CHANNELS            with imut = 159;     // 0x9F

// ── Clusters and blocks ─────────────────────────────────────────────

let is i64 as MK_CLUSTER             with imut = 524531317; // 0x1F43B675
let is i64 as MK_TIMECODE            with imut = 231;     // 0xE7
let is i64 as MK_SIMPLE_BLOCK        with imut = 163;     // 0xA3
let is i64 as MK_BLOCK_GROUP         with imut = 160;     // 0xA0
let is i64 as MK_BLOCK               with imut = 161;     // 0xA1
let is i64 as MK_BLOCK_DURATION      with imut = 155;     // 0x9B
let is i64 as MK_REFERENCE_BLOCK     with imut = 251;     // 0xFB
let is i64 as MK_DISCARD_PADDING     with imut = 30114;   // 0x75A2

// Track types defined by the specification (documentation for callers).
let is i64 as MK_TRACK_VIDEO     with imut = 1;
let is i64 as MK_TRACK_AUDIO     with imut = 2;
let is i64 as MK_TRACK_COMPLEX   with imut = 3;
let is i64 as MK_TRACK_LOGO      with imut = 16;
let is i64 as MK_TRACK_SUBTITLE  with imut = 17;
let is i64 as MK_TRACK_BUTTONS   with imut = 18;
let is i64 as MK_TRACK_CONTROL   with imut = 32;
let is i64 as MK_TRACK_METADATA  with imut = 33;

let is i64 as MK_MAX_TRACKS with imut = 64;

struct MkTrack {
    number       as i64;    // TrackNumber, > 0
    typ          as i64;    // MK_TRACK_*
    codec_id     as *u8;    // borrowed ASCII, not NUL-terminated
    codec_id_len as i64;
    codec_priv   as *u8;    // borrowed CodecPrivate, or null with len 0
    codec_priv_len as i64;
    pixel_width  as i64;    // video only, 0 otherwise
    pixel_height as i64;
    sample_rate  as f64;    // audio only, 0.0 otherwise
    channels     as i64;    // audio only, 0 otherwise
    default_duration as i64;   // ns, 0 when absent
    codec_delay  as i64;       // ns, 0 when absent
    seek_pre_roll as i64;      // ns, 0 when absent
}

struct MkLace {
    ptr as *u8;
    len as i64;
}

struct Mk {
    src as *u8;
    len as i64;

    timecode_scale  as i64;    // ns per Timecode tick
    duration_ticks  as f64;    // raw Info Duration, in Timecode ticks
    duration        as f64;    // ns, 0 when absent

    tracks      as [64]MkTrack;
    track_count as i64;

    seg_pos as i64;            // next Segment child to inspect
    seg_end as i64;            // end of the Segment payload

    in_cluster    as i64;
    cl_pos        as i64;      // next cluster child
    cl_end        as i64;      // known end, or seg_end when unknown
    cl_unknown    as i64;
    cluster_timecode as i64;   // ticks
    cl_ts_seen    as i64;      // 1 once this cluster's Timestamp was read

    laces       as [256]MkLace;
    lace_count  as i64;
    lace_index  as i64;
    lace_pts    as i64;        // ns of the first lace
    lace_total  as i64;        // ns of the whole block, split over the laces
    lace_track  as i32;
    lace_key    as i64;
    lace_discard as i64;       // ns, from BlockGroup DiscardPadding
}

fn _track_zero(t as *MkTrack) as void {
    t.number = 0;
    t.typ = 0;
    t.codec_id = cast(*u8, 0);
    t.codec_id_len = 0;
    t.codec_priv = cast(*u8, 0);
    t.codec_priv_len = 0;
    t.pixel_width = 0;
    t.pixel_height = 0;
    t.sample_rate = 0.0;
    t.channels = 0;
    t.default_duration = 0;
    t.codec_delay = 0;
    t.seek_pre_roll = 0;
}

// ticks * scale, refused instead of overflowing. Returns 0 or I_CORRUPT.
fn _ns_from_ticks(ticks as i64, scale as i64, out as *i64) as i64 {
    if (scale <= 0) { return errno.I_CORRUPT; }
    let is i64 as limit = 4611686018427387904;   // 2^62
    if (ticks > limit / scale || ticks < 0 - (limit / scale)) {
        return errno.I_CORRUPT;
    }
    *out = ticks * scale;
    return errno.I_OK;
}

// 1 when x is a finite f64, 0 for NaN or either infinity. IEEE 754 binary64
// puts exponent bits 62..52 in the top; all ones there is an infinity (zero
// mantissa) or a NaN (nonzero mantissa). Inspecting the bits avoids needing
// an infinity literal and does not depend on how the compiler treats
// inf - inf, which is the one arithmetic trick this could otherwise use.
fn _f64_is_finite(x as f64) as i64 {
    let is f64 as v with mut = x;
    let is i64 as bits = *cast(*i64, &v);
    let is i64 as exp = (bits >> 52) & 2047;
    if (exp == 2047) { return 0; }
    return 1;
}

fn _be16(src as *u8, off as i64) as i64 {
    return (cast(i64, src[off]) << 8) | cast(i64, src[off + 1]);
}

// Track index for a Matroska TrackNumber, or -1.
fn _track_index(m as *Mk, number as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < m.track_count) {
        if (m.tracks[i].number == number) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// ── Info ────────────────────────────────────────────────────────────

fn _parse_info(m as *Mk, e as *ebml.Ebml, off as i64, size as i64) as i64 {
    let is i64 as pos with mut = off;
    let is i64 as end = off + size;
    while (pos < end) {
        let is ebml.EbmlElement as el;
        let is i64 as r with mut = ebml.ebml_read_element(e, pos, end, &el);
        if (r < 0) { return r; }
        if (el.unknown != 0) { return errno.I_CORRUPT; }
        if (el.id == MK_TIMECODE_SCALE) {
            // Declared default 1,000,000 ns. An Empty Element reads as its
            // default (RFC 8794 Section 6.1), so leave the value that
            // _mk_open set. A stored zero is a real value and still fails
            // the element's "not 0" range.
            if (el.size != 0) {
                let is i64 as v with mut = 0;
                r = ebml.ebml_uint(e, &el, &v);
                if (r < 0) { return r; }
                if (v <= 0) { return errno.I_CORRUPT; }
                m.timecode_scale = v;
            }
        } else if (el.id == MK_DURATION) {
            let is f64 as v with mut = 0.0;
            r = ebml.ebml_float(e, &el, &v);
            if (r < 0) { return r; }
            // RFC 9559 Section 5.1.2.10 gives Duration the range > 0. An
            // absent Duration is different from a present zero, and the two
            // must not collapse: zero, NaN and infinity are refused rather
            // than published as a length.
            if (_f64_is_finite(v) == 0) { return errno.I_CORRUPT; }
            if (v <= 0.0) { return errno.I_CORRUPT; }
            m.duration_ticks = v;
        }
        pos = el.next;
    }
    return errno.I_OK;
}

// ── Tracks ──────────────────────────────────────────────────────────

fn _parse_video(e as *ebml.Ebml, off as i64, size as i64,
                t as *MkTrack) as i64 {
    let is i64 as pos with mut = off;
    let is i64 as end = off + size;
    while (pos < end) {
        let is ebml.EbmlElement as el;
        let is i64 as r with mut = ebml.ebml_read_element(e, pos, end, &el);
        if (r < 0) { return r; }
        if (el.unknown != 0) { return errno.I_CORRUPT; }
        if (el.id == MK_PIXEL_WIDTH) {
            r = ebml.ebml_uint(e, &el, &t.pixel_width);
            if (r < 0) { return r; }
        } else if (el.id == MK_PIXEL_HEIGHT) {
            r = ebml.ebml_uint(e, &el, &t.pixel_height);
            if (r < 0) { return r; }
        }
        pos = el.next;
    }
    return errno.I_OK;
}

fn _parse_audio(e as *ebml.Ebml, off as i64, size as i64,
                t as *MkTrack) as i64 {
    // RFC 9559 Sections 5.1.4.1.29.1 and 5.1.4.1.29.3: SamplingFrequency
    // defaults to 8000 Hz (0x1.f4p+12) and Channels to 1 when the Audio
    // master does not carry them. The defaults belong to the presence of
    // Audio, which is why they are applied here and not to a track with no
    // Audio element at all (there, 0.0/0 records "no audio").
    t.sample_rate = 8000.0;
    t.channels = 1;

    let is i64 as pos with mut = off;
    let is i64 as end = off + size;
    while (pos < end) {
        let is ebml.EbmlElement as el;
        let is i64 as r with mut = ebml.ebml_read_element(e, pos, end, &el);
        if (r < 0) { return r; }
        if (el.unknown != 0) { return errno.I_CORRUPT; }
        if (el.id == MK_SAMPLING_FREQUENCY) {
            // An Empty Element with a declared default reads as that default
            // (RFC 8794 Section 6.1), so a zero-octet frequency leaves
            // 8000.0 in place.
            if (el.size != 0) {
                r = ebml.ebml_float(e, &el, &t.sample_rate);
                if (r < 0) { return r; }
            }
        } else if (el.id == MK_CHANNELS) {
            // Likewise a zero-octet Channels leaves 1 in place. An
            // explicitly stored zero is out of range and fails below.
            if (el.size != 0) {
                r = ebml.ebml_uint(e, &el, &t.channels);
                if (r < 0) { return r; }
            }
        }
        pos = el.next;
    }

    // Both elements carry an explicit range of > 0 (Channels: not 0). A
    // non-finite frequency, a zero or negative frequency, or a channel count
    // of zero would be reinvented by every caller, so the track is refused
    // here instead of exposing a value the specification does not allow.
    if (_f64_is_finite(t.sample_rate) == 0) { return errno.I_CORRUPT; }
    if (t.sample_rate <= 0.0) { return errno.I_CORRUPT; }
    if (t.channels <= 0) { return errno.I_CORRUPT; }
    return errno.I_OK;
}

fn _parse_entry(m as *Mk, e as *ebml.Ebml, off as i64, size as i64,
                t as *MkTrack) as i64 {
    let is i64 as pos with mut = off;
    let is i64 as end = off + size;
    while (pos < end) {
        let is ebml.EbmlElement as el;
        let is i64 as r with mut = ebml.ebml_read_element(e, pos, end, &el);
        if (r < 0) { return r; }
        if (el.unknown != 0) { return errno.I_CORRUPT; }
        if (el.id == MK_TRACK_NUMBER) {
            r = ebml.ebml_uint(e, &el, &t.number);
            if (r < 0) { return r; }
        } else if (el.id == MK_TRACK_TYPE) {
            r = ebml.ebml_uint(e, &el, &t.typ);
            if (r < 0) { return r; }
        } else if (el.id == MK_CODEC_ID) {
            let is ebml.EbmlSlice as s;
            r = ebml.ebml_str(e, &el, &s);
            if (r < 0) { return r; }
            t.codec_id = s.ptr;
            t.codec_id_len = s.len;
        } else if (el.id == MK_CODEC_PRIVATE) {
            let is ebml.EbmlSlice as s;
            r = ebml.ebml_slice(e, &el, &s);
            if (r < 0) { return r; }
            t.codec_priv = s.ptr;
            t.codec_priv_len = s.len;
        } else if (el.id == MK_DEFAULT_DURATION) {
            r = ebml.ebml_uint(e, &el, &t.default_duration);
            if (r < 0) { return r; }
            // Range "not 0" (RFC 9559 Section 5.1.4.1.13). An absent
            // DefaultDuration is 0 here and means "no fixed frame duration";
            // an element present with 0 is outside the range and is refused,
            // so the two never collapse into the same state.
            if (t.default_duration <= 0) { return errno.I_CORRUPT; }
        } else if (el.id == MK_TRACK_TIMESTAMP_SCALE) {
            // Declared default 1.0. An Empty Element reads as that default
            // (RFC 8794 Section 6.1), so there is nothing to refuse. Any
            // other stored value would scale every timestamp of this track,
            // which this stage's timing contract does not model, so say so
            // instead of ignoring it.
            if (el.size != 0) {
                let is f64 as v with mut = 0.0;
                r = ebml.ebml_float(e, &el, &v);
                if (r < 0) { return r; }
                if (v != 1.0) { return errno.I_UNSUPPORTED; }
            }
        } else if (el.id == MK_CODEC_DELAY) {
            r = ebml.ebml_uint(e, &el, &t.codec_delay);
            if (r < 0) { return r; }
            if (t.codec_delay < 0) { return errno.I_CORRUPT; }
        } else if (el.id == MK_SEEK_PRE_ROLL) {
            r = ebml.ebml_uint(e, &el, &t.seek_pre_roll);
            if (r < 0) { return r; }
            if (t.seek_pre_roll < 0) { return errno.I_CORRUPT; }
        } else if (el.id == MK_VIDEO) {
            r = _parse_video(e, el.off, el.size, t);
            if (r < 0) { return r; }
        } else if (el.id == MK_AUDIO) {
            r = _parse_audio(e, el.off, el.size, t);
            if (r < 0) { return r; }
        }
        pos = el.next;
    }
    // TrackNumber, TrackType and CodecID are mandatory (RFC 9559 Sections
    // 5.1.4.1.1, 5.1.4.1.3 and 5.1.4.1.21). Refusing the entry is the only
    // option that does not invent a type or a codec for it. TrackUID is not
    // read, so it is not required: this demuxer routes blocks by
    // TrackNumber, not by UID.
    if (t.number <= 0) { return errno.I_CORRUPT; }
    if (t.typ == 0) { return errno.I_CORRUPT; }
    if (t.codec_id_len == 0) { return errno.I_CORRUPT; }
    return errno.I_OK;
}

fn _parse_tracks(m as *Mk, e as *ebml.Ebml, off as i64, size as i64) as i64 {
    let is i64 as pos with mut = off;
    let is i64 as end = off + size;
    while (pos < end) {
        let is ebml.EbmlElement as el;
        let is i64 as r with mut = ebml.ebml_read_element(e, pos, end, &el);
        if (r < 0) { return r; }
        if (el.unknown != 0) { return errno.I_CORRUPT; }
        if (el.id == MK_TRACK_ENTRY) {
            // Refuse before writing the entry past the fixed array.
            if (m.track_count >= MK_MAX_TRACKS) { return errno.I_CORRUPT; }
            _track_zero(&m.tracks[m.track_count]);
            r = _parse_entry(m, e, el.off, el.size, &m.tracks[m.track_count]);
            if (r < 0) { return r; }
            m.track_count = m.track_count + 1;
        }
        pos = el.next;
    }
    return errno.I_OK;
}

// ── Open ────────────────────────────────────────────────────────────

// Drop every published field so a failed or finished demuxer yields nothing.
fn _mk_clear(m as *Mk) as void {
    m.src = cast(*u8, 0);
    m.len = 0;
    m.timecode_scale = 0;
    m.duration_ticks = 0.0;
    m.duration = 0.0;
    m.track_count = 0;
    m.seg_pos = 0;
    m.seg_end = 0;
    m.in_cluster = 0;
    m.cl_pos = 0;
    m.cl_end = 0;
    m.cl_unknown = 0;
    m.cluster_timecode = 0;
    m.cl_ts_seen = 0;
    m.lace_count = 0;
    m.lace_index = 0;
    m.lace_pts = 0;
    m.lace_total = 0;
    m.lace_track = 0;
    m.lace_key = 0;
    m.lace_discard = 0;
}

// Parse the file at src[0..len]. Returns 0, or a negative code:
//   I_BADMAGIC    not EBML, no Segment, or a DocType other than webm/matroska
//   I_UNSUPPORTED DocTypeReadVersion above 4, an EBML header bound outside
//                 this reader's four-byte IDs / eight-byte sizes, or a
//                 TrackTimestampScale other than 1.0
//   I_CORRUPT     malformed element, unknown size where the level forbids it,
//                 a TrackEntry without TrackNumber/TrackType/CodecID, an
//                 out-of-range Duration, DefaultDuration or Audio value,
//                 no tracks, or a track count past MK_MAX_TRACKS
//   I_EOF         a header cut short
// On failure every field is cleared, so a later mk_next returns 0.
fn mk_open(m as *Mk, src as *u8, len as i64) as i64 {
    let is i64 as r = _mk_open(m, src, len);
    if (r < 0) { _mk_clear(m); }
    return r;
}

fn _mk_open(m as *Mk, src as *u8, len as i64) as i64 {
    m.src = cast(*u8, 0);
    m.len = 0;
    m.timecode_scale = 1000000;
    m.duration_ticks = 0.0;
    m.duration = 0.0;
    m.track_count = 0;
    m.seg_pos = 0;
    m.seg_end = 0;
    m.in_cluster = 0;
    m.cl_pos = 0;
    m.cl_end = 0;
    m.cl_unknown = 0;
    m.cluster_timecode = 0;
    m.cl_ts_seen = 0;
    m.lace_count = 0;
    m.lace_index = 0;
    m.lace_pts = 0;
    m.lace_total = 0;
    m.lace_track = 0;
    m.lace_key = 0;
    m.lace_discard = 0;

    let is ebml.Ebml as e;
    let is i64 as r with mut = ebml.ebml_init(&e, src, len);
    if (r < 0) { return r; }

    let is ebml.EbmlElement as el;
    r = ebml.ebml_read_element(&e, 0, len, &el);
    if (r < 0) { return r; }
    if (el.id != EBML_HEADER) { return errno.I_BADMAGIC; }
    if (el.unknown != 0) { return errno.I_CORRUPT; }

    // DocType: mandatory, and it names the subset this demuxer implements.
    let is ebml.EbmlElement as dt;
    r = ebml.ebml_find(&e, el.off, el.next, EBML_DOC_TYPE, &dt);
    if (r < 0) { return r; }
    if (r == 0) { return errno.I_BADMAGIC; }
    let is i64 as webm = ebml.ebml_str_eq(&e, &dt, "webm");
    if (webm < 0) { return webm; }
    let is i64 as mkv = ebml.ebml_str_eq(&e, &dt, "matroska");
    if (mkv < 0) { return mkv; }
    if (webm == 0 && mkv == 0) { return errno.I_BADMAGIC; }

    // DocTypeReadVersion is optional (default 1). This reader handles <= 4.
    let is ebml.EbmlElement as rv;
    r = ebml.ebml_find(&e, el.off, el.next, EBML_DOC_TYPE_READ, &rv);
    if (r < 0) { return r; }
    if (r == 1) {
        // An Empty Element reads as the declared default (RFC 8794 Section
        // 6.1), which is 1 here, so only a stored value is checked.
        if (rv.size != 0) {
            let is i64 as v with mut = 0;
            r = ebml.ebml_uint(&e, &rv, &v);
            if (r < 0) { return r; }
            if (v <= 0) { return errno.I_CORRUPT; }
            if (v > 4) { return errno.I_UNSUPPORTED; }
        }
    }

    // The header names the vint bounds the file uses. This reader is built
    // for EBML v1, four-byte IDs and eight-byte sizes; a file declaring
    // wider ones is valid EBML but not something this reader can index.
    let is ebml.EbmlElement as lim;
    r = ebml.ebml_find(&e, el.off, el.next, EBML_READ_VERSION, &lim);
    if (r < 0) { return r; }
    if (r == 1) {
        // Default 1 (EBML v1); an Empty Element reads as the default and an
        // explicit zero is out of range.
        if (lim.size != 0) {
            let is i64 as v with mut = 0;
            r = ebml.ebml_uint(&e, &lim, &v);
            if (r < 0) { return r; }
            if (v <= 0) { return errno.I_CORRUPT; }
            if (v > 1) { return errno.I_UNSUPPORTED; }
        }
    }
    r = ebml.ebml_find(&e, el.off, el.next, EBML_MAX_ID_LENGTH, &lim);
    if (r < 0) { return r; }
    if (r == 1) {
        // Default 4, the value this reader is built for; an Empty Element
        // reads as that default (RFC 8794 Section 6.1).
        if (lim.size != 0) {
            let is i64 as v with mut = 0;
            r = ebml.ebml_uint(&e, &lim, &v);
            if (r < 0) { return r; }
            if (v <= 0 || v > 4) { return errno.I_UNSUPPORTED; }
        }
    }
    r = ebml.ebml_find(&e, el.off, el.next, EBML_MAX_SIZE_LENGTH, &lim);
    if (r < 0) { return r; }
    if (r == 1) {
        // Default 8, likewise.
        if (lim.size != 0) {
            let is i64 as v with mut = 0;
            r = ebml.ebml_uint(&e, &lim, &v);
            if (r < 0) { return r; }
            if (v <= 0 || v > 8) { return errno.I_UNSUPPORTED; }
        }
    }

    // Segment, allowing Void/CRC padding between it and the header.
    let is i64 as pos = el.next;
    let is i64 as seg_found with mut = 0;
    let is ebml.EbmlElement as seg;
    let is i64 as scan with mut = pos;
    while (scan < len) {
        r = ebml.ebml_read_element(&e, scan, len, &seg);
        if (r < 0) { return r; }
        if (seg.id == MK_SEGMENT) { seg_found = 1; break; }
        if (seg.unknown != 0) { return errno.I_CORRUPT; }
        if (ebml.ebml_is_skippable(seg.id) == 0) { return errno.I_BADMAGIC; }
        scan = seg.next;
    }
    if (seg_found == 0) { return errno.I_BADMAGIC; }

    m.src = src;
    m.len = len;
    m.seg_pos = seg.off;
    if (seg.unknown != 0) { m.seg_end = len; }
    else { m.seg_end = seg.next; }

    // Walk the Segment until the first Cluster, collecting Info and Tracks.
    // Everything else at this level (SeekHead, Cues, Tags, Chapters, Void,
    // CRC-32) is skipped by its validated size.
    let is i64 as p with mut = seg.off;
    while (p < m.seg_end) {
        let is ebml.EbmlElement as child;
        r = ebml.ebml_read_element(&e, p, m.seg_end, &child);
        if (r < 0) { return r; }
        if (child.id == MK_CLUSTER) { break; }
        if (child.unknown != 0) { return errno.I_CORRUPT; }
        if (child.id == MK_INFO) {
            r = _parse_info(m, &e, child.off, child.size);
            if (r < 0) { return r; }
        } else if (child.id == MK_TRACKS) {
            r = _parse_tracks(m, &e, child.off, child.size);
            if (r < 0) { return r; }
        }
        p = child.next;
    }
    m.seg_pos = p;
    if (m.track_count == 0) { return errno.I_CORRUPT; }

    m.duration = m.duration_ticks * cast(f64, m.timecode_scale);
    return errno.I_OK;
}

// ── Cluster walk ────────────────────────────────────────────────────

// Move to the next Cluster at Segment level: 1 started, 0 end of segment, or
// a negative code. Non-cluster children (SeekHead, Cues, ...) are skipped.
fn _next_cluster(m as *Mk, e as *ebml.Ebml) as i64 {
    while (m.seg_pos < m.seg_end) {
        let is ebml.EbmlElement as el;
        let is i64 as r = ebml.ebml_read_element(e, m.seg_pos, m.seg_end, &el);
        if (r < 0) { return r; }
        if (el.id == MK_CLUSTER) {
            m.in_cluster = 1;
            m.cl_pos = el.off;
            m.cl_unknown = el.unknown;
            m.cluster_timecode = 0;
            m.cl_ts_seen = 0;
            if (el.unknown != 0) {
                m.cl_end = m.seg_end;
                m.seg_pos = m.seg_end;
            } else {
                m.cl_end = el.next;
                m.seg_pos = el.next;
            }
            return 1;
        }
        if (el.unknown != 0) { return errno.I_CORRUPT; }
        m.seg_pos = el.next;
    }
    return 0;
}

// Parse laces from a block payload in [pos, end). Fills m.laces and writes
// the count through *out_count. Returns 0 or a negative code; nothing is
// published as a packet until the whole lacing header checks out.
fn _parse_laces(m as *Mk, pos as i64, end as i64, lacing as i64,
                out_count as *i64) as i64 {
    let is i64 as rem = end - pos;
    if (rem < 0) { return errno.I_CORRUPT; }

    if (lacing == 0) {
        m.laces[0].ptr = cast(*u8, cast(i64, m.src) + pos);
        m.laces[0].len = rem;
        *out_count = 1;
        return errno.I_OK;
    }

    if (pos >= end) { return errno.I_CORRUPT; }
    let is i64 as count = cast(i64, m.src[pos]) + 1;
    let is i64 as q with mut = pos + 1;

    let is [256]i64 as sizes;
    let is i64 as sum with mut = 0;
    let is i64 as i with mut = 0;

    if (lacing == 1) {
        // Xiph: count-1 sizes; each is a run of 255 bytes plus a final byte.
        while (i < count - 1) {
            let is i64 as s with mut = 0;
            while (1) {
                if (q >= end) { return errno.I_CORRUPT; }
                let is i64 as b = cast(i64, m.src[q]);
                q = q + 1;
                s = s + b;
                if (s > end - q) { return errno.I_CORRUPT; }
                if (b != 255) { break; }
            }
            sizes[i] = s;
            sum = sum + s;
            if (sum > end - q) { return errno.I_CORRUPT; }
            i = i + 1;
        }
    } else if (lacing == 2) {
        // Fixed: equal frames, so the remaining bytes must divide evenly.
        let is i64 as each = (end - q) / count;
        if (each * count != end - q) { return errno.I_CORRUPT; }
        while (i < count) {
            sizes[i] = each;
            sum = sum + each;
            i = i + 1;
        }
    } else {
        // EBML: first size is unsigned; each later size is a biased signed
        // difference from the previous one. The last is the remainder.
        // RFC 9559 Section 10.3.3 encodes these as VINTs, and the all-ones
        // "unknown" reservation belongs to Element Data Size alone (RFC 8794
        // Section 6.2): 0xFF is the first size 127, or +64 as a one-byte
        // difference, never a sentinel. *v.value* is therefore used as is.
        let is i64 as prev with mut = 0;
        while (i < count - 1) {
            let is ebml.EbmlVint as v;
            let is i64 as r = ebml.ebml_read_vint(m.src, q, end, 0, &v);
            if (r < 0) { return r; }
            q = v.next;
            if (i == 0) {
                prev = v.value;
            } else {
                let is i64 as bias = (1 << (7 * v.len - 1)) - 1;
                prev = prev + (v.value - bias);
                if (prev < 0) { return errno.I_CORRUPT; }
            }
            sizes[i] = prev;
            sum = sum + prev;
            if (sum > end - q) { return errno.I_CORRUPT; }
            i = i + 1;
        }
    }

    // The last frame is whatever is left; a negative remainder is a corrupt
    // size table, caught before any pointer or length is published.
    if (i < count) {
        let is i64 as last = (end - q) - sum;
        if (last < 0) { return errno.I_CORRUPT; }
        sizes[count - 1] = last;
        i = count;
    }

    let is i64 as p with mut = q;
    i = 0;
    while (i < count) {
        if (sizes[i] < 0 || sizes[i] > end - p) { return errno.I_CORRUPT; }
        m.laces[i].ptr = cast(*u8, cast(i64, m.src) + p);
        m.laces[i].len = sizes[i];
        p = p + sizes[i];
        i = i + 1;
    }
    *out_count = count;
    return errno.I_OK;
}

// Parse a Block/SimpleBlock payload and fill the pending lace list with its
// timestamps. `key_in` is -1 to take the keyframe bit from the block flags
// (SimpleBlock); 0/1 override it (BlockGroup sets it from ReferenceBlock).
// `have_dur`/`dur_ticks` carry BlockDuration; `discard` is DiscardPadding ns.
fn _parse_block(m as *Mk, off as i64, size as i64, key_in as i64,
                have_dur as i64, dur_ticks as i64, discard as i64) as i64 {
    let is i64 as end = off + size;
    let is i64 as pos with mut = off;

    let is ebml.EbmlVint as tv;
    let is i64 as r with mut = ebml.ebml_read_vint(m.src, pos, end, 0, &tv);
    if (r < 0) { return r; }
    // The Track Number is a VINT (RFC 9559 Sections 10.1 and 10.2), not an
    // Element Data Size, so all-ones data bits are a number: 0xFF is track
    // 127. The "unknown" sentinel does not apply here.
    pos = tv.next;
    if (end - pos < 3) { return errno.I_CORRUPT; }

    // SimpleBlock flags: 0x80 keyframe, 0x70 reserved, 0x08 invisible (no
    // effect on framing), 0x06 lacing mode, 0x01 discardable. Block inside a
    // BlockGroup carries the same layout; its keyframe comes from
    // ReferenceBlock instead.
    let is i64 as rel = _be16(m.src, pos);
    let is i64 as rel_signed with mut = rel;
    if (rel_signed >= 32768) { rel_signed = rel_signed - 65536; }
    let is i64 as flags = cast(i64, m.src[pos + 2]);
    pos = pos + 3;

    let is i64 as key with mut = key_in;
    if (key_in < 0) {
        key = 0;
        if ((flags & 128) != 0) { key = 1; }
    }
    let is i64 as lacing = (flags >> 1) & 3;

    let is i64 as ti = _track_index(m, tv.value);
    if (ti < 0) { return errno.I_CORRUPT; }
    let is *MkTrack as t = &m.tracks[ti];

    let is i64 as count with mut = 0;
    r = _parse_laces(m, pos, end, lacing, &count);
    if (r < 0) { return r; }

    let is i64 as base_ns with mut = 0;
    r = _ns_from_ticks(m.cluster_timecode + rel_signed, m.timecode_scale,
                       &base_ns);
    if (r < 0) { return r; }

    let is i64 as total with mut = 0;
    if (have_dur != 0) {
        r = _ns_from_ticks(dur_ticks, m.timecode_scale, &total);
        if (r < 0) { return r; }
    } else {
        // No BlockDuration: the block spans one DefaultDuration per lace.
        if (t.default_duration > 4611686018427387904 / count) {
            return errno.I_CORRUPT;
        }
        total = t.default_duration * count;
    }
    if (base_ns > 0 && total > 4611686018427387904 - base_ns) {
        return errno.I_CORRUPT;
    }

    m.lace_count = count;
    m.lace_index = 0;
    m.lace_pts = base_ns;
    m.lace_total = total;
    m.lace_track = cast(i32, ti);
    m.lace_key = key;
    m.lace_discard = discard;
    return errno.I_OK;
}

// Parse a BlockGroup: Block plus the metadata that overrides it. A block with
// no ReferenceBlock is a keyframe. Returns 0 or a negative code.
fn _parse_block_group(m as *Mk, e as *ebml.Ebml, off as i64,
                      size as i64) as i64 {
    let is i64 as pos with mut = off;
    let is i64 as end = off + size;
    let is i64 as block_off with mut = 0;
    let is i64 as block_size with mut = 0;
    let is i64 as have_block with mut = 0;
    let is i64 as key with mut = 1;
    let is i64 as dur with mut = 0;
    let is i64 as have_dur with mut = 0;
    let is i64 as discard with mut = 0;

    while (pos < end) {
        let is ebml.EbmlElement as el;
        let is i64 as r with mut = ebml.ebml_read_element(e, pos, end, &el);
        if (r < 0) { return r; }
        if (el.unknown != 0) { return errno.I_CORRUPT; }
        if (el.id == MK_BLOCK) {
            block_off = el.off;
            block_size = el.size;
            have_block = 1;
        } else if (el.id == MK_REFERENCE_BLOCK) {
            key = 0;
        } else if (el.id == MK_BLOCK_DURATION) {
            r = ebml.ebml_uint(e, &el, &dur);
            if (r < 0) { return r; }
            if (dur < 0) { return errno.I_CORRUPT; }
            have_dur = 1;
        } else if (el.id == MK_DISCARD_PADDING) {
            r = ebml.ebml_int(e, &el, &discard);
            if (r < 0) { return r; }
            // RFC 9559 Section 5.1.3.5.7: a positive value is padding at
            // the end of the Block, a negative one is padding at its
            // beginning. Packet's discard padding is end padding only, so
            // there is nowhere to report a start padding: returning its
            // magnitude would trim the wrong end, and dropping it would
            // hide the sample. Refuse the case instead.
            if (discard < 0) { return errno.I_UNSUPPORTED; }
        }
        pos = el.next;
    }

    if (have_block == 0) { return errno.I_CORRUPT; }
    return _parse_block(m, block_off, block_size, key, have_dur, dur, discard);
}

// One step inside the current cluster. Returns 1 when laces are ready to be
// handed out, 0 when the element was skipped or the cluster ended, or a
// negative code.
fn _cluster_step(m as *Mk, e as *ebml.Ebml) as i64 {
    while (m.cl_pos < m.cl_end) {
        let is i64 as start = m.cl_pos;
        let is ebml.EbmlElement as el;
        let is i64 as r with mut = ebml.ebml_read_element(e, start, m.cl_end, &el);
        // An element that overruns its cluster leaves nothing to resynchronise
        // on. Everything before it was valid, so the stream ends here.
        if (r < 0) {
            m.in_cluster = 0;
            m.seg_pos = m.seg_end;
            return 0;
        }

        if (el.id == MK_CLUSTER) {
            // Only an unknown-size cluster can be ended by a sibling, whose
            // header we just read. Rewind so Segment level reads it again.
            if (m.cl_unknown == 0) { return errno.I_CORRUPT; }
            m.seg_pos = start;
            m.in_cluster = 0;
            return 0;
        }
        if (el.unknown != 0) { return errno.I_CORRUPT; }

        if (el.id == MK_TIMECODE) {
            r = ebml.ebml_uint(e, &el, &m.cluster_timecode);
            if (r < 0) { return r; }
            if (m.cluster_timecode < 0) { return errno.I_CORRUPT; }
            if (m.cluster_timecode > 4611686018427387904) {
                return errno.I_CORRUPT;
            }
            m.cl_ts_seen = 1;
            m.cl_pos = el.next;
            continue;
        }
        if (el.id == MK_SIMPLE_BLOCK) {
            // Cluster Timestamp is mandatory (RFC 9559 Section 5.1.3.1). A
            // block before it would otherwise be stamped from a zero that
            // was never in the file, so refuse rather than place it at 0.
            if (m.cl_ts_seen == 0) { return errno.I_CORRUPT; }
            r = _parse_block(m, el.off, el.size, 0 - 1, 0, 0, 0);
            if (r < 0) { return r; }
            m.cl_pos = el.next;
            return 1;
        }
        if (el.id == MK_BLOCK_GROUP) {
            if (m.cl_ts_seen == 0) { return errno.I_CORRUPT; }
            r = _parse_block_group(m, e, el.off, el.size);
            if (r < 0) { return r; }
            m.cl_pos = el.next;
            return 1;
        }
        m.cl_pos = el.next;
    }

    m.in_cluster = 0;
    if (m.cl_unknown == 0) { m.seg_pos = m.cl_end; }
    return 0;
}

// ── Public iteration ────────────────────────────────────────────────

// Next packet: 1 with *pkt filled, 0 at a clean end of stream, or a negative
// code: I_CORRUPT on malformed input, or I_UNSUPPORTED for a BlockGroup
// DiscardPadding that pads the start of the block, which Packet cannot carry.
// Track is the 0-based index into the exposed track list; pts/dts/duration
// are nanoseconds.
fn mk_next(m as *Mk, pkt as *packet.Packet) as i64 {
    while (1) {
        if (m.lace_index < m.lace_count) {
            let is i64 as i = m.lace_index;
            let is i64 as count = m.lace_count;
            // floor(total*(i+1)/count) - floor(total*i/count), computed from
            // the quotient and remainder so the products stay small. pts is
            // the sum of the preceding lace durations.
            let is i64 as q = m.lace_total / count;
            let is i64 as rem = m.lace_total % count;
            let is i64 as dur = q + (rem * (i + 1)) / count - (rem * i) / count;
            let is i64 as pts = m.lace_pts + q * i + (rem * i) / count;
            let is i64 as r with mut = packet.packet_set(pkt, m.laces[i].ptr,
                                                m.laces[i].len, m.lace_track,
                                                pts, pts, dur, m.lace_key);
            if (r < 0) { return r; }
            r = packet.packet_set_discard_padding(pkt, m.lace_discard);
            if (r < 0) { return r; }
            m.lace_index = m.lace_index + 1;
            return 1;
        }

        if (m.in_cluster != 0) {
            let is ebml.Ebml as e;
            e.src = m.src;
            e.len = m.len;
            let is i64 as r = _cluster_step(m, &e);
            if (r < 0) { return r; }
            continue;
        }

        let is ebml.Ebml as e2;
        e2.src = m.src;
        e2.len = m.len;
        let is i64 as s = _next_cluster(m, &e2);
        if (s < 0) { return s; }
        if (s == 0) { return 0; }
    }
    return 0;
}

fn mk_track_count(m as *Mk) as i64 {
    return m.track_count;
}

// Track by 0-based index, or a null pointer when the index is out of range.
fn mk_track(m as *Mk, i as i64) as *MkTrack {
    if (i < 0 || i >= m.track_count) { return cast(*MkTrack, 0); }
    return &m.tracks[i];
}

fn mk_timecode_scale(m as *Mk) as i64 {
    return m.timecode_scale;
}

// Segment duration in nanoseconds, 0.0 when Info did not carry one.
fn mk_duration(m as *Mk) as f64 {
    return m.duration;
}

fn _strlen(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

// Compare a track's CodecID against a NUL-terminated string. 1 equal, 0 not.
fn mk_track_codec_eq(t as *MkTrack, s as *u8) as i64 {
    let is i64 as n = _strlen(s);
    if (n != t.codec_id_len) { return 0; }
    let is i64 as i with mut = 0;
    while (i < n) {
        if (t.codec_id[i] != s[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
