// =======================================================
// caustic-av/examples/md5.cst
// RFC 1321 MD5, for the example's per-frame I420 hashes.
//
// The core/ tree has no digest module; MD5 is needed only to compare decoded
// video with libvpx's test/md5_helper.h and with FFmpeg's rawvideo output, so
// it lives beside the example instead of in the library.
//
// This is a straight implementation of RFC 1321: the four-word state, the
// 64-byte block, the FF/GG/HH/II rounds with their published constants, the
// 0x80 pad, and the 64-bit little-endian bit length. The per-frame layout
// (which bytes are fed to md5_update) is the caller's business; decode.cst
// feeds visible I420 planes row by row, tight, as libvpx and FFmpeg do.
//
// The tables are fields of Md5 rather than module globals: Caustic has no
// array initialiser, and this keeps two contexts from sharing mutable state.
// =======================================================

let is i64 as MD5_BLOCK with imut = 64;

struct Md5 {
    a as u32;
    b as u32;
    c as u32;
    d as u32;
    total as i64;       // message bytes fed so far
    fill as i64;        // bytes currently in buf, 0..63
    buf as [64]u8;
    k as [64]u32;       // RFC 1321 round constants
    s as [64]i64;       // RFC 1321 per-step rotate counts
}

// The two tables are identical for every message, but Caustic has no static
// array literal. Filling them per context is cheap (128 stores) and keeps the
// module re-entrant.
fn _md5_tables(m as *Md5) as void {
    m.k[ 0] = 0xd76aa478; m.k[ 1] = 0xe8c7b756;
    m.k[ 2] = 0x242070db; m.k[ 3] = 0xc1bdceee;
    m.k[ 4] = 0xf57c0faf; m.k[ 5] = 0x4787c62a;
    m.k[ 6] = 0xa8304613; m.k[ 7] = 0xfd469501;
    m.k[ 8] = 0x698098d8; m.k[ 9] = 0x8b44f7af;
    m.k[10] = 0xffff5bb1; m.k[11] = 0x895cd7be;
    m.k[12] = 0x6b901122; m.k[13] = 0xfd987193;
    m.k[14] = 0xa679438e; m.k[15] = 0x49b40821;

    m.k[16] = 0xf61e2562; m.k[17] = 0xc040b340;
    m.k[18] = 0x265e5a51; m.k[19] = 0xe9b6c7aa;
    m.k[20] = 0xd62f105d; m.k[21] = 0x02441453;
    m.k[22] = 0xd8a1e681; m.k[23] = 0xe7d3fbc8;
    m.k[24] = 0x21e1cde6; m.k[25] = 0xc33707d6;
    m.k[26] = 0xf4d50d87; m.k[27] = 0x455a14ed;
    m.k[28] = 0xa9e3e905; m.k[29] = 0xfcefa3f8;
    m.k[30] = 0x676f02d9; m.k[31] = 0x8d2a4c8a;

    m.k[32] = 0xfffa3942; m.k[33] = 0x8771f681;
    m.k[34] = 0x6d9d6122; m.k[35] = 0xfde5380c;
    m.k[36] = 0xa4beea44; m.k[37] = 0x4bdecfa9;
    m.k[38] = 0xf6bb4b60; m.k[39] = 0xbebfbc70;
    m.k[40] = 0x289b7ec6; m.k[41] = 0xeaa127fa;
    m.k[42] = 0xd4ef3085; m.k[43] = 0x04881d05;
    m.k[44] = 0xd9d4d039; m.k[45] = 0xe6db99e5;
    m.k[46] = 0x1fa27cf8; m.k[47] = 0xc4ac5665;

    m.k[48] = 0xf4292244; m.k[49] = 0x432aff97;
    m.k[50] = 0xab9423a7; m.k[51] = 0xfc93a039;
    m.k[52] = 0x655b59c3; m.k[53] = 0x8f0ccc92;
    m.k[54] = 0xffeff47d; m.k[55] = 0x85845dd1;
    m.k[56] = 0x6fa87e4f; m.k[57] = 0xfe2ce6e0;
    m.k[58] = 0xa3014314; m.k[59] = 0x4e0811a1;
    m.k[60] = 0xf7537e82; m.k[61] = 0xbd3af235;
    m.k[62] = 0x2ad7d2bb; m.k[63] = 0xeb86d391;

    m.s[ 0] =  7; m.s[ 1] = 12; m.s[ 2] = 17; m.s[ 3] = 22;
    m.s[ 4] =  7; m.s[ 5] = 12; m.s[ 6] = 17; m.s[ 7] = 22;
    m.s[ 8] =  7; m.s[ 9] = 12; m.s[10] = 17; m.s[11] = 22;
    m.s[12] =  7; m.s[13] = 12; m.s[14] = 17; m.s[15] = 22;

    m.s[16] =  5; m.s[17] =  9; m.s[18] = 14; m.s[19] = 20;
    m.s[20] =  5; m.s[21] =  9; m.s[22] = 14; m.s[23] = 20;
    m.s[24] =  5; m.s[25] =  9; m.s[26] = 14; m.s[27] = 20;
    m.s[28] =  5; m.s[29] =  9; m.s[30] = 14; m.s[31] = 20;

    m.s[32] =  4; m.s[33] = 11; m.s[34] = 16; m.s[35] = 23;
    m.s[36] =  4; m.s[37] = 11; m.s[38] = 16; m.s[39] = 23;
    m.s[40] =  4; m.s[41] = 11; m.s[42] = 16; m.s[43] = 23;
    m.s[44] =  4; m.s[45] = 11; m.s[46] = 16; m.s[47] = 23;

    m.s[48] =  6; m.s[49] = 10; m.s[50] = 15; m.s[51] = 21;
    m.s[52] =  6; m.s[53] = 10; m.s[54] = 15; m.s[55] = 21;
    m.s[56] =  6; m.s[57] = 10; m.s[58] = 15; m.s[59] = 21;
    m.s[60] =  6; m.s[61] = 10; m.s[62] = 15; m.s[63] = 21;
}

fn _rotl32(x as u32, k as i64) as u32 {
    if (k <= 0) { return x; }
    if (k >= 32) { return x; }
    return (x << cast(u32, k)) | (x >> cast(u32, 32 - k));
}

fn _load32(p as *u8, off as i64) as u32 {
    let is u32 as b0 = cast(u32, p[off]);
    let is u32 as b1 = cast(u32, p[off + 1]);
    let is u32 as b2 = cast(u32, p[off + 2]);
    let is u32 as b3 = cast(u32, p[off + 3]);
    return b0 | (b1 << cast(u32, 8)) | (b2 << cast(u32, 16))
              | (b3 << cast(u32, 24));
}

fn _store32(p as *u8, off as i64, v as u32) as void {
    p[off]     = cast(u8, v & cast(u32, 255));
    p[off + 1] = cast(u8, (v >> cast(u32, 8)) & cast(u32, 255));
    p[off + 2] = cast(u8, (v >> cast(u32, 16)) & cast(u32, 255));
    p[off + 3] = cast(u8, (v >> cast(u32, 24)) & cast(u32, 255));
}

fn _md5_block(m as *Md5, block as *u8) as void {
    let is [16]u32 as x;
    let is i64 as i with mut = 0;
    while (i < 16) {
        x[i] = _load32(block, i * 4);
        i = i + 1;
    }

    let is u32 as av with mut = m.a;
    let is u32 as bv with mut = m.b;
    let is u32 as cv with mut = m.c;
    let is u32 as dv with mut = m.d;

    i = 0;
    while (i < 64) {
        let is u32 as f with mut = 0;
        let is i64 as g with mut = 0;
        if (i < 16) {
            f = (bv & cv) | ((~bv) & dv);          // F
            g = i;
        } else if (i < 32) {
            f = (dv & bv) | ((~dv) & cv);          // G
            g = (5 * i + 1) % 16;
        } else if (i < 48) {
            f = bv ^ cv ^ dv;                       // H
            g = (3 * i + 5) % 16;
        } else {
            f = cv ^ (bv | (~dv));                  // I
            g = (7 * i) % 16;
        }

        // The RFC's FF/GG/HH/II rotate which variable plays a,b,c,d; the
        // equivalent loop keeps the names and rotates the roles explicitly.
        let is u32 as tmp = dv;
        dv = cv;
        cv = bv;
        bv = bv + _rotl32(av + f + m.k[i] + x[g], m.s[i]);
        av = tmp;
        i = i + 1;
    }

    m.a = m.a + av;
    m.b = m.b + bv;
    m.c = m.c + cv;
    m.d = m.d + dv;
}

fn md5_init(m as *Md5) as void {
    if (cast(i64, m) == 0) { return; }
    m.a = 0x67452301;
    m.b = 0xefcdab89;
    m.c = 0x98badcfe;
    m.d = 0x10325476;
    m.total = 0;
    m.fill = 0;
    _md5_tables(m);
}

// Feed n bytes. A null pointer with n > 0 or a negative n is ignored; the
// example only feeds rows it validated itself.
fn md5_update(m as *Md5, data as *u8, n as i64) as void {
    if (cast(i64, m) == 0) { return; }
    if (n <= 0) { return; }
    if (cast(i64, data) == 0) { return; }

    m.total = m.total + n;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as take with mut = MD5_BLOCK - m.fill;
        if (take > n - i) { take = n - i; }
        let is i64 as j with mut = 0;
        while (j < take) {
            m.buf[m.fill + j] = data[i + j];
            j = j + 1;
        }
        m.fill = m.fill + take;
        i = i + take;
        if (m.fill == MD5_BLOCK) {
            _md5_block(m, &m.buf[0]);
            m.fill = 0;
        }
    }
}

// Finish and write the 16-byte digest (RFC 1321, little-endian words).
// The context is not reusable afterwards.
fn md5_final(m as *Md5, digest as *u8) as void {
    if (cast(i64, m) == 0 || cast(i64, digest) == 0) { return; }

    let is u64 as bits = cast(u64, m.total) * cast(u64, 8);
    let is i64 as index with mut = m.fill;
    m.buf[index] = cast(u8, 0x80);
    index = index + 1;
    if (index > 56) {
        let is i64 as j with mut = index;
        while (j < MD5_BLOCK) { m.buf[j] = cast(u8, 0); j = j + 1; }
        _md5_block(m, &m.buf[0]);
        index = 0;
    }
    let is i64 as z with mut = index;
    while (z < 56) { m.buf[z] = cast(u8, 0); z = z + 1; }

    let is i64 as b with mut = 0;
    while (b < 8) {
        m.buf[56 + b] = cast(u8, (bits >> cast(u64, 8 * b)) & cast(u64, 255));
        b = b + 1;
    }
    _md5_block(m, &m.buf[0]);

    _store32(digest, 0, m.a);
    _store32(digest, 4, m.b);
    _store32(digest, 8, m.c);
    _store32(digest, 12, m.d);
}

// 32 lowercase hex digits and a NUL into out (33 bytes).
fn md5_hex(digest as *u8, out as *u8) as void {
    if (cast(i64, digest) == 0 || cast(i64, out) == 0) { return; }
    let is *u8 as hex = "0123456789abcdef";
    let is i64 as i with mut = 0;
    while (i < 16) {
        let is i64 as v = cast(i64, digest[i]);
        out[i * 2] = hex[v >> 4];
        out[i * 2 + 1] = hex[v & 15];
        i = i + 1;
    }
    out[32] = cast(u8, 0);
}
